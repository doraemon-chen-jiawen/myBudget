<view class="backfill-page">
  <!-- Date selection -->
  <view class="section-card">
    <view class="section-title">日期选择</view>
    <view class="mode-switch">
      <view
        class="mode-btn {{!dateRangeMode ? 'mode-btn-active' : ''}}"
        bindtap="onDateRangeModeSwitch"
        data-mode="single"
      >单日期</view>
      <view
        class="mode-btn {{dateRangeMode ? 'mode-btn-active' : ''}}"
        bindtap="onDateRangeModeSwitch"
        data-mode="range"
      >日期范围</view>
    </view>

    <!-- Single date picker -->
    <picker
      wx:if="{{!dateRangeMode}}"
      mode="date"
      value="{{selectedDate}}"
      bindchange="onDateChange"
    >
      <view class="picker-row">
        <text class="picker-label">选择日期</text>
        <text class="picker-value">{{selectedDate || '请选择'}}</text>
      </view>
    </picker>

    <!-- Date range pickers -->
    <view wx:else class="date-range-pickers">
      <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
        <view class="picker-row">
          <text class="picker-label">开始日期</text>
          <text class="picker-value">{{startDate || '请选择'}}</text>
        </view>
      </picker>
      <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
        <view class="picker-row">
          <text class="picker-label">结束日期</text>
          <text class="picker-value">{{endDate || '请选择'}}</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- Amount mode -->
  <view class="section-card">
    <view class="section-title">金额设置</view>
    <view class="mode-switch">
      <view
        class="mode-btn {{amountMode === 'custom' ? 'mode-btn-active' : ''}}"
        bindtap="onAmountModeSwitch"
        data-mode="custom"
      >自定义金额</view>
      <view
        class="mode-btn {{amountMode === 'budget' ? 'mode-btn-active' : ''}}"
        bindtap="onAmountModeSwitch"
        data-mode="budget"
      >按日预算</view>
    </view>

    <!-- Custom amount input -->
    <view wx:if="{{amountMode === 'custom'}}" class="input-group">
      <text class="input-label">每日金额</text>
      <input
        class="input-field"
        type="digit"
        placeholder="请输入金额"
        value="{{customAmount}}"
        bindinput="onAmountInput"
      />
      <text class="input-hint">元/天</text>
    </view>

    <!-- Daily budget info -->
    <view wx:else class="budget-info">
      <text class="budget-label">当前日预算</text>
      <text class="budget-value">¥{{dailyBudget}}</text>
    </view>
  </view>

  <!-- Preview -->
  <view class="section-card preview-card">
    <view class="section-title">预览</view>
    <view class="preview-info">
      <view class="preview-item">
        <text class="preview-label">补记天数</text>
        <text class="preview-value">{{previewDays}} 天</text>
      </view>

      <!-- Budget mode: show category breakdown -->
      <view wx:if="{{amountMode === 'budget' && previewItems.length > 0}}">
        <view class="preview-item">
          <text class="preview-label">分类明细</text>
        </view>
        <view class="category-breakdown">
          <view class="breakdown-item" wx:for="{{previewItems}}" wx:key="categoryKey">
            <view class="breakdown-row">
              <text class="breakdown-icon">{{item.icon}}</text>
              <text class="breakdown-label">{{item.label}}</text>
              <text class="breakdown-amount">¥{{item.amount}}/天</text>
            </view>
            <text class="breakdown-total">小计: ¥{{item.totalAmount}}</text>
          </view>
        </view>
      </view>

      <!-- Custom mode: show single amount -->
      <view class="preview-item" wx:if="{{amountMode === 'custom'}}">
        <text class="preview-label">每日金额</text>
        <text class="preview-value">¥{{previewDailyAmount}}</text>
      </view>

      <view class="preview-item preview-total">
        <text class="preview-label">总计金额</text>
        <text class="preview-value highlight">¥{{previewTotal}}</text>
      </view>
    </view>
  </view>

  <!-- Category selection (hidden when using budget mode) -->
  <view class="section-card" wx:if="{{amountMode !== 'budget'}}">
    <view class="section-title">选择分类</view>
    <scroll-view class="category-scroll" scroll-x>
      <view class="category-list">
        <view
          wx:for="{{categories}}"
          wx:key="categoryKey"
          class="category-chip {{selectedCategory && selectedCategory.categoryKey === item.categoryKey ? 'category-chip-active' : ''}}"
          data-item="{{item}}"
          bindtap="onSelectCategory"
        >
          <text class="category-icon">{{item.icon}}</text>
          <text class="category-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Budget mode info -->
  <view class="section-card" wx:else>
    <view class="section-title">分类说明</view>
    <view class="info-box">
      <text class="info-text">按日预算补记时，将使用预算总金额进行记账，分类将自动设置为默认分类</text>
    </view>
  </view>

  <!-- Note (optional) -->
  <view class="section-card">
    <view class="section-title">备注（可选）</view>
    <textarea
      class="textarea-field"
      placeholder="请输入备注信息"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="100"
    />
  </view>

  <!-- Submit button -->
  <view class="submit-section">
    <button
      class="submit-btn"
      bindtap="onSubmit"
      disabled="{{loading}}"
    >{{loading ? '提交中...' : '确认补记'}}</button>
  </view>
</view>
