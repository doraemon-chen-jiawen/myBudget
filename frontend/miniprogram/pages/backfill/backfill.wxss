.backfill-page {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 120rpx;
}

.section-card {
  background: #ffffff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 20rpx;
}

.mode-switch {
  display: flex;
  background: #F1F5F9;
  border-radius: 1000rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #64748B;
  border-radius: 1000rpx;
  transition: all 0.2s;
}

.mode-btn-active {
  background: #6FCF97;
  color: #ffffff;
  font-weight: 500;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.picker-label {
  font-size: 28rpx;
  color: #64748B;
}

.picker-value {
  font-size: 28rpx;
  color: #1E293B;
}

.date-range-pickers {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.input-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-label {
  font-size: 28rpx;
  color: #64748B;
}

.input-field {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #F1F5F9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.input-hint {
  font-size: 24rpx;
  color: #94A3B8;
}

.budget-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: rgba(111, 207, 151, 0.1);
  border-radius: 12rpx;
}

.budget-label {
  font-size: 28rpx;
  color: #4A9B6E;
}

.budget-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #6FCF97;
}

.preview-card {
  background: linear-gradient(135deg, #6FCF97 0%, #4ECDC4 100%);
}

.preview-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-item.preview-total {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.3);
}

.preview-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.preview-value {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.preview-value.highlight {
  font-size: 36rpx;
  font-weight: 700;
}

/* Category breakdown for budget mode */
.category-breakdown {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 12rpx 0;
}

.breakdown-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.breakdown-item:last-child {
  border-bottom: none;
}

.breakdown-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.breakdown-icon {
  font-size: 26rpx;
}

.breakdown-label {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
}

.breakdown-amount {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.breakdown-total {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
  text-align: right;
}

/* Info box */
.info-box {
  background: rgba(111, 207, 151, 0.1);
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-text {
  font-size: 26rpx;
  color: #4A9B6E;
  line-height: 1.5;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 1000rpx;
  background: #F1F5F9;
  transition: all 0.2s;
}

.category-chip-active {
  background: rgba(111, 207, 151, 0.15);
  border: 2rpx solid #6FCF97;
}

.category-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.category-label {
  font-size: 26rpx;
  color: #64748B;
}

.category-chip-active .category-label {
  color: #4A9B6E;
  font-weight: 500;
}

.textarea-field {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: #F1F5F9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #6FCF97;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #CBD5E1;
  color: #94A3B8;
}
