.detail-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: 160rpx;
}

/* 预览图 */
.preview-section {
  width: 100%;
  height: 500rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(45, 42, 38, 0.04);
}

.preview-img {
  width: 100%;
  height: 500rpx;
}

/* 点击查看大图提示 */
.preview-zoom-hint {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(45, 42, 38, 0.6);
  border-radius: 100rpx;
  padding: 10rpx 24rpx;
  backdrop-filter: blur(4px);
}

.preview-zoom-hint-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 120rpx;
  opacity: 0.3;
}

/* 基础信息 */
.info-card {
  margin: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.drawing-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-bottom: 12rpx;
}

.drawing-desc {
  display: block;
  font-size: 26rpx;
  color: #8C857C;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
}

.info-tag {
  background: rgba(242, 153, 74, 0.1);
  color: #F2994A;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
}

.total-beads {
  font-size: 24rpx;
  color: #B8B0A4;
}


.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-tag {
  font-size: 22rpx;
  color: #8C857C;
  background: #FAF7F2;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

/* 用料清单 */
.materials-card {
  margin: 0 32rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
}

.material-count {
  font-size: 24rpx;
  color: #B8B0A4;
}

.material-list {
  display: flex;
  flex-direction: column;
}

.material-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.material-item:last-child {
  border-bottom: none;
}

.material-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid #F0EBE3;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.material-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2A26;
  width: 100rpx;
  flex-shrink: 0;
}

.material-name {
  flex: 1;
  font-size: 26rpx;
  color: #8C857C;
}

.material-qty {
  font-size: 26rpx;
  font-weight: 600;
  color: #F2994A;
  flex-shrink: 0;
}

/* 操作按钮 */
.action-section {
  margin: 0 32rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  background: #ffffff;
  border: none;
  border-radius: 20rpx;
  padding: 0;
  margin: 0;
  box-shadow: 0 2rpx 12rpx rgba(242, 153, 74, 0.06);
  color: #2D2A26;
  transition: transform 0.15s;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.97);
}

.action-btn-favorited {
  background: rgba(255, 107, 107, 0.06);
  color: #FF6B6B;
}

/* 免责声明 */
.disclaimer {
  text-align: center;
  padding: 32rpx 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #CCC4B8;
}

/* 加载 */
.loading-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAF7F2;
}

.loading-text {
  font-size: 28rpx;
  color: #B8B0A4;
}

/* 底部拼接状态栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(45, 42, 38, 0.08);
}

.bottom-bar-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s;
}

.bottom-bar-btn--active {
  background: #F2994A;
  color: #ffffff;
}

.bottom-bar-btn--active:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.bottom-bar-btn--done {
  background: #F5F0E8;
  color: #B8B0A4;
}
