<view class="detail-page" wx:if="{{!loading && drawing}}">
  <!-- 预览图 -->
  <view class="preview-section" bindtap="onPreviewImage">
    <image wx:if="{{drawing.preview_image}}" class="preview-img" src="{{drawing.preview_image}}" mode="aspectFit" />
    <view wx:else class="preview-placeholder">
      <text class="placeholder-icon">📐</text>
    </view>
    <view wx:if="{{drawing.preview_image}}" class="preview-zoom-hint">
      <text class="preview-zoom-hint-text">点击查看大图</text>
    </view>
  </view>

  <!-- 基础信息 -->
  <view class="info-card">
    <text class="drawing-title">{{drawing.name}}</text>
    <text wx:if="{{drawing.description}}" class="drawing-desc">{{drawing.description}}</text>
    <view class="info-row">
      <view class="info-tag">
        <text>{{drawing.width}}×{{drawing.height}}</text>
      </view>
      <text class="total-beads">共 {{drawing.totalBeads}} 颗豆子</text>
    </view>
    <!-- 标签 -->
    <view class="tag-row" wx:if="{{drawing.tags && drawing.tags.length > 0}}">
      <text
        wx:for="{{drawing.tags}}"
        wx:key="id"
        class="detail-tag"
      >{{item.name}}</text>
    </view>
  </view>

  <!-- 用料清单 -->
  <view class="materials-card">
    <view class="card-header">
      <text class="card-title">用料清单</text>
      <text class="material-count">{{drawing.materials.length}} 种颜色</text>
    </view>
    <view class="material-list">
      <view
        wx:for="{{drawing.materials}}"
        wx:key="id"
        class="material-item"
      >
        <view class="material-color" style="background: {{item.colorRgb || 'rgb(200,200,200)'}};"></view>
        <text class="material-code">{{item.color_code}}</text>
        <text class="material-name">{{item.color_name || ''}}</text>
        <text class="material-qty">{{item.quantity}} 颗</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <view class="action-row">
      <button wx:if="{{!isConversion}}" class="action-btn {{isFavorited ? 'action-btn-favorited' : ''}}" bindtap="onToggleFavorite">
        <text>{{isFavorited ? '❤️ 已收藏' : '🤍 收藏'}}</text>
      </button>
      <button class="action-btn action-btn-primary" bindtap="onCopyMaterials">
        <text>📋 复制清单</text>
      </button>
      <button class="action-btn" bindtap="onCheckStock">
        <text>📦 核对库存</text>
      </button>
    </view>
  </view>

  <!-- 底部拼接状态栏（仅 conversion 来源） -->
  <view wx:if="{{isConversion}}" class="bottom-bar">
    <view wx:if="{{!drawing.is_assembled}}" class="bottom-bar-btn bottom-bar-btn--active" bindtap="onToggleAssembled">
      <text>标记为已拼</text>
    </view>
    <view wx:else class="bottom-bar-btn bottom-bar-btn--done">
      <text>✅ 已完成</text>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disclaimer-text">本工具仅供个人手工创作参考，禁止商用</text>
  </view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading}}" class="loading-page">
  <text class="loading-text">加载中...</text>
</view>
