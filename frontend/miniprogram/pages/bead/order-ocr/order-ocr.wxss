/* 订单 OCR 入库页面样式 */
.order-ocr-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: 120rpx;
}

/* 输入模式切换 */
.mode-switch {
  display: flex;
  background-color: #fff;
  margin: 24rpx 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.mode-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #8C857C;
  transition: all 0.3s;
}

.mode-item.active {
  background: #F2994A;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(242, 153, 74, 0.3);
}

.mode-item .icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

/* 输入区域 */
.input-section {
  margin: 0 32rpx 24rpx;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.image-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background: #FAF7F2;
  border: 2rpx dashed #E8E0D4;
}

.upload-icon {
  font-size: 80rpx;
  color: #B8B0A4;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #8C857C;
}

.order-image {
  width: 100%;
  height: 400rpx;
}

.order-textarea {
  width: 100%;
  height: 400rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #2D2A26;
}

/* 操作按钮栏 */
.action-bar {
  padding: 0 32rpx;
}

.recognize-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2994A;
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(242, 153, 74, 0.3);
  padding: 0;
}

.recognize-btn::after { border: none; }

.recognize-btn[disabled] {
  background: #E8E0D4;
  box-shadow: none;
  color: #B8B0A4;
}

/* 识别结果区域 */
.result-section {
  margin: 24rpx 32rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F0E8;
}

.result-header .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
}

.result-header .tip {
  font-size: 24rpx;
  color: #B8B0A4;
}

/* 物料列表 - 可编辑行 */
.item-list {
  margin-bottom: 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.item-row:last-child { border-bottom: none; }

/* 无效色号行样式 */
.item-invalid {
  opacity: 0.6;
}

.code-invalid {
  border: 2rpx solid #FF6B6B !important;
  color: #FF6B6B !important;
}

.item-fields {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.field-input {
  height: 68rpx;
  padding: 0 20rpx;
  background: #FAF7F2;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #2D2A26;
}

.field-code {
  width: 160rpx;
  flex: none;
  font-weight: 600;
}

.field-count {
  flex: 1;
}

.item-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.del-icon {
  font-size: 28rpx;
  color: #FF6B6B;
}

/* 添加物料按钮 */
.add-item-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border: 2rpx dashed #E8E0D4;
  border-radius: 16rpx;
  color: #F2994A;
  font-size: 28rpx;
}

/* 确认入库栏 */
.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(45, 42, 38, 0.06);
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #6FCF97;
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(111, 207, 151, 0.3);
  padding: 0;
}

.confirm-btn::after { border: none; }