<!--订单 OCR 入库页面-->
<view class="order-ocr-page">
  <!-- 输入模式切换 -->
  <view class="mode-switch">
    <view
      class="mode-item {{inputMode === 'image' ? 'active' : ''}}"
      data-mode="image"
      bindtap="switchMode"
    >
      <text class="icon">📷</text>
      <text>图片识别</text>
    </view>
    <view
      class="mode-item {{inputMode === 'text' ? 'active' : ''}}"
      data-mode="text"
      bindtap="switchMode"
    >
      <text class="icon">📝</text>
      <text>文本输入</text>
    </view>
  </view>

  <!-- 图片输入模式 -->
  <view class="input-section" wx:if="{{inputMode === 'image'}}">
    <view class="image-upload" bindtap="chooseImage" wx:if="{{!imagePath}}">
      <text class="upload-icon">+</text>
      <text class="upload-text">点击上传订单图片</text>
    </view>
    <image class="order-image" src="{{imagePath}}" mode="aspectFit" wx:else />
  </view>

  <!-- 文本输入模式 -->
  <view class="input-section" wx:if="{{inputMode === 'text'}}">
    <textarea
      class="order-textarea"
      placeholder="请粘贴订单文本，每行一个物料：色号 数量&#10;例如：&#10;A01 100&#10;B05 50"
      value="{{orderText}}"
      bindinput="onTextInput"
      maxlength="2000"
    />
  </view>

  <!-- 识别按钮 -->
  <view class="action-bar">
    <button
      class="recognize-btn"
      bindtap="recognize"
      disabled="{{loading}}"
    >
      {{loading ? '识别中...' : '开始识别'}}
    </button>
  </view>

  <!-- 识别结果 -->
  <view class="result-section" wx:if="{{items.length > 0}}">
    <view class="result-header">
      <text class="title">识别结果（{{items.length}}条）</text>
      <text class="tip">可编辑色号和数量</text>
    </view>

    <view class="item-list">
      <view class="item-row {{item.invalid ? 'item-invalid' : ''}}" wx:for="{{items}}" wx:key="index">
        <view class="item-fields">
          <input
            class="field-input field-code {{item.invalid ? 'code-invalid' : ''}}"
            value="{{item.code}}"
            placeholder="色号"
            data-index="{{index}}"
            data-field="code"
            bindinput="onFieldInput"
          />
          <input
            class="field-input field-count"
            type="number"
            value="{{item.count}}"
            placeholder="数量"
            data-index="{{index}}"
            data-field="count"
            bindinput="onFieldInput"
          />
        </view>
        <view class="item-delete" data-index="{{index}}" bindtap="deleteItem">
          <text class="del-icon">✕</text>
        </view>
      </view>
    </view>

    <!-- 添加物料按钮 -->
    <view class="add-item-btn" bindtap="addItem">
      <text>+ 添加物料</text>
    </view>
  </view>

  <!-- 确认入库按钮 -->
  <view class="confirm-bar" wx:if="{{items.length > 0}}">
    <button class="confirm-btn" bindtap="confirmStockIn">
      确认入库
    </button>
  </view>
</view>