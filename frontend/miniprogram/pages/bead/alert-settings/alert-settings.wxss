/* 库存预警设置页面样式 */
.alert-settings-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding: 24rpx 32rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 设置卡片 */
.settings-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F0E8;
}

/* 设置项 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.setting-item:last-child {
  border-bottom: none;
}

.item-label {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.label-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2A26;
  margin-bottom: 8rpx;
}

.label-desc {
  font-size: 24rpx;
  color: #B8B0A4;
}

.item-value {
  display: flex;
  align-items: center;
}

.item-value input {
  width: 150rpx;
  height: 64rpx;
  border: 1rpx solid #F0EBE3;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  margin-right: 10rpx;
  background: #FAF7F2;
  color: #2D2A26;
}

.unit {
  font-size: 26rpx;
  color: #8C857C;
}

/* 说明卡片 */
.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(45, 42, 38, 0.05);
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 24rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #8C857C;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.dot.green { background-color: #6FCF97; }
.dot.yellow { background-color: #F2C94C; }
.dot.red { background-color: #FF6B6B; }

/* 操作按钮栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(45, 42, 38, 0.06);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2994A;
  color: #fff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(242, 153, 74, 0.3);
  padding: 0;
}

.save-btn::after { border: none; }

.save-btn[disabled] {
  background: #E8E0D4;
  box-shadow: none;
  color: #B8B0A4;
}
