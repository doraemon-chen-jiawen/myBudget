<!--库存预警设置页面-->
<view class="alert-settings-page">
  <view class="settings-card">
    <view class="card-title">预警阈值设置</view>

    <!-- 低库存阈值 -->
    <view class="setting-item">
      <view class="item-label">
        <text class="label-text">低库存阈值</text>
        <text class="label-desc">库存低于此值时显示黄色预警</text>
      </view>
      <view class="item-value">
        <input
          type="number"
          value="{{lowStockThreshold}}"
          bindinput="onLowStockChange"
        />
        <text class="unit">颗</text>
      </view>
    </view>

    <!-- 缺货阈值 -->
    <view class="setting-item">
      <view class="item-label">
        <text class="label-text">缺货阈值</text>
        <text class="label-desc">库存低于或等于此值时显示红色预警</text>
      </view>
      <view class="item-value">
        <input
          type="number"
          value="{{outOfStockThreshold}}"
          bindinput="onOutOfStockChange"
        />
        <text class="unit">颗</text>
      </view>
    </view>
  </view>

  <!-- 说明卡片 -->
  <view class="info-card">
    <view class="info-title">📖 预警说明</view>
    <view class="info-list">
      <view class="info-item">
        <text class="dot green"></text>
        <text>正常库存：大于低库存阈值</text>
      </view>
      <view class="info-item">
        <text class="dot yellow"></text>
        <text>低库存：介于缺货阈值和低库存阈值之间</text>
      </view>
      <view class="info-item">
        <text class="dot red"></text>
        <text>缺货：小于或等于缺货阈值</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="action-bar">
    <button
      class="save-btn"
      bindtap="saveSettings"
      disabled="{{loading}}"
    >
      {{loading ? '保存中...' : '保存设置'}}
    </button>
  </view>
</view>
