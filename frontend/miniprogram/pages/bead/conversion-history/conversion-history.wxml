<!--转换记录页面-->
<view class="conversion-history-page">
  <!-- 记录列表 -->
  <view class="records-list" wx:if="{{records.length > 0}}">
    <view
      class="record-item"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="viewRecord"
      data-id="{{item.id}}"
    >
      <view class="record-header">
        <text class="record-name">{{item.name}}</text>
        <text class="record-time">{{item.created_at}}</text>
      </view>

      <view class="record-content">
        <view class="record-info">
          <text class="info-label">尺寸：</text>
          <text class="info-value">{{item.width}}×{{item.height}}</text>
        </view>
        <view class="record-info">
          <text class="info-label">来源：</text>
          <text class="info-value">{{item.source === 'ocr' ? '图纸识别' : '图片转换'}}</text>
        </view>
      </view>

      <view class="record-actions">
        <view class="action-btn">查看详情</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{records.length === 0 && !loading}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无转换记录</text>
    <button class="go-convert-btn" bindtap="goConvert">去转换</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
