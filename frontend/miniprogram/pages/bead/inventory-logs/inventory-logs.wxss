/* 库存日志页面样式 */
.inventory-logs-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: 20rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #ffffff;
  padding: 20rpx 32rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(242, 153, 74, 0.06);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  margin: 0 10rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8C857C;
  background: #FAF7F2;
  transition: all 0.3s;
}

.filter-item.active {
  background: rgba(242, 153, 74, 0.12);
  color: #F2994A;
  font-weight: 600;
}

/* 统计信息 */
.stats-info {
  padding: 20rpx 32rpx;
  font-size: 24rpx;
  color: #B8B0A4;
  text-align: center;
}

/* 日志列表 */
.logs-list {
  padding: 0 32rpx;
}

.log-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(242, 153, 74, 0.06);
}

/* 日志头部 */
.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.log-type {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.log-type.in {
  background: rgba(111, 207, 151, 0.12);
  color: #6FCF97;
}

.log-type.out {
  background: rgba(255, 107, 107, 0.1);
  color: #FF6B6B;
}

.log-time {
  font-size: 24rpx;
  color: #B8B0A4;
}

/* 日志内容 */
.log-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #F5F0E8;
  border-bottom: 1rpx solid #F5F0E8;
}

.log-color {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.color-code {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 6rpx;
}

.color-name {
  font-size: 24rpx;
  color: #B8B0A4;
}

.log-quantity {
  font-size: 36rpx;
  font-weight: 700;
}

.log-quantity.plus { color: #6FCF97; }
.log-quantity.minus { color: #FF6B6B; }

/* 来源信息 */
.log-source {
  padding-top: 16rpx;
  font-size: 24rpx;
  color: #B8B0A4;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #B8B0A4;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #CCC4B8;
}
