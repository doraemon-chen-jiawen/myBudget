.warehouse-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 统计卡片 */
.stats-card {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #F2994A 0%, #F2C94C 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(242, 153, 74, 0.25);
}

.stats-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.stats-card::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.stats-grid {
  display: flex;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
}

.warn { color: rgba(255, 255, 255, 0.8); }
.danger { color: #FFF5F5; }

.stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.stat-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}

.stat-drawing { font-size: 24rpx; opacity: 0.9; }
.stat-link { font-size: 24rpx; font-weight: 600; }

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 28rpx;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  transition: transform 0.15s;
}

.action-btn::after { border: none; }

.action-in {
  background: #ffffff;
  color: #F2994A;
  box-shadow: 0 2rpx 16rpx rgba(242, 153, 74, 0.1);
}

.action-out {
  background: #ffffff;
  color: #FF6B6B;
  box-shadow: 0 2rpx 16rpx rgba(255, 107, 107, 0.1);
}

.action-ocr {
  background: #ffffff;
  color: #8B5CF6;
  box-shadow: 0 2rpx 16rpx rgba(139, 92, 246, 0.1);
}

/* 缺货列表 */
.shortage-section {
  padding: 0 32rpx;
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
}

.section-subtitle {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 500;
}

.shortage-list {
  display: flex;
  flex-direction: column;
}

.shortage-item {
  display: flex;
  align-items: center;
  background: #fff5f5;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid #ffe0e0;
}

.shortage-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 20rpx;
}

.shortage-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #D32F2F;
}

.shortage-name {
  font-size: 22rpx;
  color: #B8B0A4;
}

.shortage-nums {
  display: flex;
  gap: 10rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.shortage-demand {
  color: #F2994A;
}

.shortage-stock {
  color: #8C857C;
}

.shortage-gap {
  color: #D32F2F;
  font-weight: 700;
}

/* 库存列表 */
.inventory-section {
  padding: 0 32rpx;
}

.inventory-item .section-title {
  display: block;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-state.small { padding: 40rpx 0; }

.empty-text {
  font-size: 28rpx;
  color: #B8B0A4;
}

.inventory-list {
  display: flex;
  flex-direction: column;
}

.inventory-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(242, 153, 74, 0.06);
  transition: transform 0.15s;
}

.inventory-item:active {
  transform: scale(0.98);
}

.color-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid #F0EBE3;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

.item-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
}

.item-name {
  font-size: 24rpx;
  color: #B8B0A4;
}

.item-qty {
  font-size: 30rpx;
  font-weight: 700;
  color: #F2994A;
  flex-shrink: 0;
}

.item-nums {
  display: flex;
  gap: 8rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.item-demand {
  color: #F2994A;
}

.item-stock-num {
  color: #8C857C;
}

.item-gap {
  font-weight: 700;
}

.item-gap.warn {
  color: #D32F2F;
}

.item-gap.ok {
  color: #4CAF50;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 42, 38, 0.4);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(45, 42, 38, 0.2);
}

.modal-content-lg {
  width: 700rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2A26;
}

.modal-close {
  font-size: 32rpx;
  color: #B8B0A4;
  padding: 8rpx;
}

.modal-body {
  padding: 12rpx 32rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.form-code {
  width: 180rpx;
  flex: none;
}

.form-qty {
  flex: 1;
}

.form-input {
  height: 76rpx;
  padding: 0 20rpx;
  background: #FAF7F2;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.del-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FF6B6B;
}

.add-row { padding: 16rpx 0; text-align: center; }
.add-text { font-size: 26rpx; color: #F2994A; font-weight: 500; }

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  padding: 0;
}

.modal-btn::after { border: none; }
.modal-cancel { background: #F5F0E8; color: #8C857C; }
.modal-confirm { background: #F2994A; color: #ffffff; box-shadow: 0 4rpx 16rpx rgba(242, 153, 74, 0.3); }
.modal-confirm-danger { background: #FF6B6B; color: #ffffff; box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3); }

/* 统计配置 */
.stat-section {
  margin-bottom: 24rpx;
}

.stat-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8C857C;
  margin-bottom: 16rpx;
}

.stat-config-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F0E8;
}

.stat-config-item:last-child {
  border-bottom: none;
}

.stat-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #D4CCC0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ffffff;
  transition: all 0.2s;
}

.stat-checkbox.checked {
  background: #F2994A;
  border-color: #F2994A;
}

.stat-item-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-item-name {
  font-size: 28rpx;
  color: #2D2A26;
  font-weight: 500;
}

.stat-item-size {
  font-size: 24rpx;
  color: #B8B0A4;
}