.drawing-page {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ======== 筛选区域 — 木质收纳格 ======== */
.filter-section {
  padding: 24rpx 32rpx 20rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 20rpx rgba(233, 147, 60, 0.06);
  position: relative;
  z-index: 2;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 24rpx;
  color: #B8B0A4;
  width: 60rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  font-weight: 500;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-btn {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 100rpx;
  background: #FAF7F2;
  font-size: 24rpx;
  color: #8C857C;
  margin-right: 12rpx;
  transition: all 0.25s ease;
  font-weight: 400;
}

.filter-btn-active {
  background: linear-gradient(135deg, #F2994A 0%, #F2C94C 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(242, 153, 74, 0.3);
}

/* ======== 图纸列表 ======== */
.drawing-list {
  padding: 20rpx 32rpx;
}

.drawing-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(233, 147, 60, 0.06), 0 1rpx 4rpx rgba(45, 42, 38, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
}

.drawing-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(233, 147, 60, 0.08);
}

/* ======== 缩略图 ======== */
.drawing-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #FFF5EB 0%, #FFECD2 100%);
  position: relative;
}

.thumb-img {
  width: 140rpx;
  height: 140rpx;
}

.thumb-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.thumb-size {
  font-size: 24rpx;
  font-weight: 700;
  color: #E8913A;
  letter-spacing: 1rpx;
}

/* ======== 信息区域 ======== */
.drawing-info {
  flex: 1;
  min-width: 0;
}

.drawing-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2A26;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawing-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 8rpx 8rpx 0;
}

.tag-size {
  color: #E8913A;
  background: rgba(242, 153, 74, 0.08);
}

.tag-assembled {
  color: #4CAF82;
  background: rgba(111, 207, 151, 0.12);
}

.tag-pending {
  color: #B8B0A4;
  background: rgba(184, 176, 164, 0.1);
}

.drawing-meta {
  display: block;
  font-size: 22rpx;
  color: #B8B0A4;
  font-weight: 400;
}

/* ======== 操作按钮 ======== */
.drawing-actions {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 50%;
  transition: transform 0.15s;
  background: #FAF7F2;
}

.action-btn:active {
  transform: scale(0.85);
}

.action-btn-del {
  background: #FFF5F5;
}

.del-icon {
  font-size: 24rpx;
}

/* ======== 空状态 ======== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 80rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #B8B0A4;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCC4B8;
  text-align: center;
  max-width: 400rpx;
}

/* ======== 加载 ======== */
.loading-tip {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #CCC4B8;
}

/* ======== 新建图纸浮动按钮 ======== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F2994A 0%, #F2C94C 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(242, 153, 74, 0.4);
  z-index: 100;
  transition: transform 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}