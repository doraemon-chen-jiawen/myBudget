.bead-profile {
  min-height: 100vh;
  background: #FAF7F2;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ======== 头部 — 暖色渐变 ======== */
.header-section {
  background: linear-gradient(168deg, #F2994A 0%, #F2C94C 60%, #FFECD2 100%);
  padding: 56rpx 40rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: 30rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.avatar-text {
  font-size: 52rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 12rpx rgba(242, 153, 74, 0.3);
}

.header-wave {
  height: 48rpx;
  background: #FAF7F2;
  border-radius: 48rpx 48rpx 0 0;
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

/* ======== 菜单组 — 工坊抽屉 ======== */
.menu-group {
  margin: 24rpx 32rpx 0;
}

.switch-section {
  margin: 24rpx 32rpx 0;
}

.menu-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(233, 147, 60, 0.06), 0 1rpx 4rpx rgba(45, 42, 38, 0.03);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  transition: background 0.15s;
  position: relative;
}

.menu-item + .menu-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 96rpx;
  right: 28rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #F5F0E8 20%, #F5F0E8 80%, transparent 100%);
}

.menu-item-active {
  background: rgba(242, 153, 74, 0.04);
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5EB 0%, #FFECD2 100%);
  border-radius: 50%;
  flex-shrink: 0;
}

.menu-text-wrap {
  display: flex;
  flex-direction: column;
  margin-left: 4rpx;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
}

.menu-desc {
  font-size: 22rpx;
  color: #B8B0A4;
  margin-top: 4rpx;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 预警红点 */
.alert-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #FF6B6B;
  box-shadow: 0 0 8rpx rgba(255, 107, 107, 0.4);
}

.arrow-icon {
  font-size: 44rpx;
  color: #D4CCC0;
  font-weight: 300;
}

/* ======== 退出登录 ======== */
.logout-section {
  margin: 48rpx 32rpx 0;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B6B;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(45, 42, 38, 0.04);
  padding: 0;
  letter-spacing: 2rpx;
}

.logout-btn::after {
  border: none;
}

.logout-btn-active {
  background: #FFF5F5 !important;
  transform: scale(0.98);
}

/* ======== 底部 ======== */
.footer {
  text-align: center;
  padding: 48rpx 0 80rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #CCC4B8;
  letter-spacing: 1rpx;
}