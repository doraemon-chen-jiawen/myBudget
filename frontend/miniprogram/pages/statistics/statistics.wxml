<view class="stats-page">
  <!-- Dimension tabs -->
  <view class="dim-tabs">
    <view
      wx:for="{{dimensionTabs}}"
      wx:key="key"
      class="dim-tab {{activeDimIndex === index ? 'dim-tab-active' : ''}}"
      data-index="{{index}}"
      hover-class="dim-tab-hover"
      bindtap="onSwitchDimension"
    >{{item.label}}</view>
  </view>

  <!-- Date nav -->
  <view class="date-nav">
    <view class="date-arrow" hover-class="date-arrow-active" bindtap="onPrevDate">‹</view>
    <text class="date-text">{{periodLabel || currentDate}}</text>
    <view class="date-arrow" hover-class="date-arrow-active" bindtap="onNextDate">›</view>
  </view>

  <!-- Family member selector -->
  <scroll-view class="member-scroll" scroll-x wx:if="{{familyMembers.length > 0}}">
    <view class="member-list">
      <view
        wx:for="{{familyMembers}}"
        wx:key="index"
        class="member-chip {{selectedMemberIndex === index ? 'member-chip-active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectMember"
      >
        <view class="member-avatar">{{item.isAll ? '👥' : (item.nickname.charAt(0))}}</view>
        <text class="member-name">{{item.nickname}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Summary card -->
  <view class="summary-card">
    <view class="summary-row main-row">
      <view class="summary-block">
        <text class="summary-label">预算总额</text>
        <text class="summary-value budget">¥{{summary.budgetTotal}}</text>
      </view>
    </view>
    <view class="summary-row sub-row">
      <view class="summary-block">
        <text class="summary-label">实际花费</text>
        <text class="summary-value expense">¥{{summary.actualTotal}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-block">
        <text class="summary-label">剩余预算</text>
        <text class="summary-value remain">¥{{summary.remainTotal}}</text>
      </view>
    </view>
    <!-- Overall progress -->
    <view class="overall-progress" wx:if="{{summary.budgetTotal > 0}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progressWidth}}%; background: {{progressColor}};"></view>
      </view>
      <text class="progress-label">总预算使用 {{overallPercent}}%</text>
    </view>
  </view>

  <!-- Category breakdown -->
  <view class="section-header">
    <text class="section-title">分类明细</text>
  </view>

  <view class="category-list" wx:if="{{categories.length > 0}}">
    <view class="category-card" wx:for="{{categories}}" wx:key="categoryKey">
      <view class="cat-header">
        <view class="cat-left">
          <view class="cat-icon" style="background: {{item.bgColor}};">
            <text class="cat-icon-text">{{item.icon}}</text>
          </view>
          <text class="cat-label">{{item.categoryLabel}}</text>
        </view>
        <text class="cat-percent" style="color: {{item.percent >= 100 ? '#FF6B6B' : item.percent >= 80 ? '#FFB38A' : '#6FCF97'}};">{{item.percent}}%</text>
      </view>
      <view class="cat-progress">
        <view class="cat-progress-track">
          <view class="cat-progress-fill" style="width: {{item.percent > 100 ? 100 : item.percent}}%; background: {{item.percent >= 100 ? '#FF6B6B' : item.percent >= 80 ? '#FFB38A' : '#6FCF97'}};"></view>
        </view>
      </view>
      <view class="cat-amounts">
        <text class="cat-amount">实际 ¥{{item.actual}}</text>
        <text class="cat-budget">预算 ¥{{item.budgeted}}</text>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{!loading && categories.length === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无数据</text>
    <text class="empty-hint">该时间段内没有预算和消费记录</text>
  </view>

  <!-- Loading -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
