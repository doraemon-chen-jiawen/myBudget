/* Statistics Page */
.stats-page {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 80rpx;
}

/* ===== Dimension Tabs ===== */
.dim-tabs {
  display: flex;
  padding: 28rpx 32rpx 16rpx;
  background: #ffffff;
  gap: 16rpx;
}

.dim-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #64748B;
  border-radius: 1000rpx;
  background: #F1F5F9;
  transition: all 0.2s;
}

.dim-tab-active {
  background: #6FCF97;
  color: #ffffff;
  font-weight: 600;
}

.dim-tab-hover {
  opacity: 0.85;
}

/* ===== Date Nav ===== */
.date-nav-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: #ffffff;
  gap: 24rpx;
}

.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  flex: 1;
}

.date-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #64748B;
  border-radius: 50%;
  transition: background 0.2s;
}

.date-arrow-active {
  background: #f0f2f5;
}

.date-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E293B;
  margin: 0 32rpx;
  min-width: 240rpx;
  text-align: center;
}

.date-text-clickable {
  cursor: pointer;
  transition: color 0.2s;
}

.date-text-clickable:active {
  color: #6FCF97;
}

/* ===== Member Selector ===== */
.member-scroll {
  white-space: nowrap;
  padding: 0 24rpx 20rpx;
  background: #ffffff;
  box-sizing:border-box;
}

.member-list {
  display: inline-flex;
  gap: 20rpx;
}

.member-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 1000rpx;
  background: #F1F5F9;
  transition: all 0.2s;
}

.member-chip-active {
  background: rgba(111, 207, 151, 0.15);
  border: 2rpx solid #6FCF97;
}

.member-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
  color: #64748B;
}

.member-chip-active .member-avatar {
  background: rgba(111, 207, 151, 0.2);
  color: #6FCF97;
}

.member-name {
  font-size: 24rpx;
  color: #64748B;
}

.member-chip-active .member-name {
  color: #4A9B6E;
  font-weight: 500;
}

/* ===== Summary Card ===== */
.summary-card {
  position: relative;
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(111, 207, 151, 0.08);
  animation: fade-up 0.4s ease-out both;
}

.summary-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.backfill-btn-corner {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0fdf4;
  border-radius: 50%;
  transition: all 0.2s;
}

.backfill-btn-corner .backfill-icon {
  font-size: 32rpx;
}

.summary-row {
  display: flex;
  align-items: center;
}

.main-row {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
  flex: 1;
}

.sub-row {
  justify-content: space-around;
}

.summary-block {
  display: flex;
  flex-direction: column;
  flex: 1;
  align-items: center;
}

.summary-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
}

.summary-value.budget {
  color: #1E293B;
}

.summary-value.expense {
  color: #FF6B6B;
}

.summary-value.remain {
  color: #6FCF97;
}

.summary-value.income {
  color: #52C41A;
}

.summary-value.balance {
  color: #1890FF;
}

.income-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: #e2e8f0;
}

/* Overall progress */
.overall-progress {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f5;
}

.progress-track {
  height: 16rpx;
  background: #F1F5F9;
  border-radius: 1000rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 1000rpx;
  transition: width 0.5s ease;
}

.progress-label {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 8rpx;
  display: block;
  text-align: center;
}

/* ===== Section Header ===== */
.section-header {
  padding: 32rpx 32rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}

/* ===== Category Cards ===== */
.category-list {
  padding: 0 24rpx;
}

.category-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.025);
  animation: fade-up 0.4s ease-out both;
}

.cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cat-left {
  display: flex;
  align-items: center;
}

.cat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.cat-icon-text {
  font-size: 28rpx;
}

.cat-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E293B;
}

.cat-percent {
  font-size: 28rpx;
  font-weight: 700;
}

/* Category progress bar */
.cat-progress {
  margin-bottom: 12rpx;
}

.cat-progress-track {
  height: 12rpx;
  background: #F1F5F9;
  border-radius: 1000rpx;
  overflow: hidden;
}

.cat-progress-fill {
  height: 100%;
  border-radius: 1000rpx;
  transition: width 0.5s ease;
  min-width: 4rpx;
}

.cat-amounts {
  display: flex;
  justify-content: space-between;
}

.cat-amount {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

.cat-budget {
  font-size: 22rpx;
  color: #94A3B8;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  animation: fade-in 0.5s ease-out both;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #64748B;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #94A3B8;
}

/* ===== Loading ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(248, 250, 252, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #6FCF97;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* ===== Animations ===== */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.backfill-btn-active {
  opacity: 0.85;
  transform: scale(0.95);
}

.backfill-icon {
  font-size: 28rpx;
  line-height: 1;
}

.backfill-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}
.calendar-btn-container {
  padding: 0 24rpx 16rpx;
  background: #ffffff;
}

.calendar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: #f0fdf4;
  border-radius: 16rpx;
  border: 2rpx solid #d1fae5;
}

.calendar-btn-active {
  background: #d1fae5;
  transform: scale(0.98);
}

.calendar-btn-icon {
  font-size: 32rpx;
}

.calendar-btn-text {
  font-size: 28rpx;
  color: #059669;
  font-weight: 500;
}

/* ===== Calendar Modal ===== */
.calendar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.calendar-modal--show {
  opacity: 1;
  visibility: visible;
}

.calendar-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.calendar-modal-content {
  position: relative;
  width: 680rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  transform: scale(0.92) translateY(30rpx);
  transition: transform 0.3s ease;
}

.calendar-modal--show .calendar-modal-content {
  transform: scale(1) translateY(0);
}

.calendar-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.calendar-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.calendar-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #64748B;
}

.calendar-modal-footer {
  padding: 16rpx 32rpx 24rpx;
  border-top: 1rpx solid #f0f2f5;
}

.calendar-nav-btns {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.calendar-nav-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #64748B;
  transition: all 0.2s;
}

.calendar-nav-btn:active {
  background: #e2e8f0;
}

.backfill-btn-active {
  opacity: 0.85;
  transform: scale(0.95);
}

.backfill-icon {
  font-size: 28rpx;
  line-height: 1;
}

.backfill-text {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}

