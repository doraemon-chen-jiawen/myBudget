<view class="records-page">
  <!-- Month selector -->
  <view class="month-nav">
    <view class="month-arrow" hover-class="month-arrow-active" bindtap="onPrevMonth">‹</view>
    <text class="month-text">{{currentMonth}}</text>
    <view class="month-arrow" hover-class="month-arrow-active" bindtap="onNextMonth">›</view>
  </view>

  <!-- Type filter tabs -->
  <view class="type-tabs">
    <view
      wx:for="{{typeTabs}}"
      wx:key="key"
      class="type-tab {{activeTypeIndex === index ? 'type-tab-active' : ''}}"
      data-index="{{index}}"
      hover-class="type-tab-hover"
      bindtap="onSwitchType"
    >{{item.label}}</view>
  </view>

  <!-- Records list -->
  <view class="records-list" wx:if="{{groupedRecords.length > 0}}">
    <view class="date-group" wx:for="{{groupedRecords}}" wx:key="date">
      <view class="date-header">
        <text class="date-label">{{item.dayLabel}}</text>
        <view class="date-summary">
          <text class="date-expense" wx:if="{{item.dayExpense > 0}}">支 ¥{{item.dayExpense}}</text>
          <text class="date-income" wx:if="{{item.dayIncome > 0}}">收 ¥{{item.dayIncome}}</text>
        </view>
      </view>
      <view class="record-card">
        <view class="record-item {{rec.isRetracted ? 'disabled' : ''}}" wx:for="{{item.items}}" wx:for-item="rec" wx:key="id">
          <view
            class="record-item-content {{rec.swiped ? 'swiped' : ''}} {{rec.isRetract ? 'retract-record' : ''}}"
            bindtouchstart="onTouchStart"
            bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd"
            data-id="{{rec.id}}"
            data-amount="{{rec.amount}}"
            data-type="{{rec.type}}"
            data-category="{{rec.category}}"
            data-note="{{rec.note}}"
            data-record-date="{{rec.recordDate}}"
          >
            <view class="record-left">
              <view class="record-icon {{rec.type === 'expense' ? 'icon-expense' : 'icon-income'}} {{rec.isRetract ? 'icon-retract' : ''}}">
                <text class="record-icon-text">{{rec.isRetract ? '↺' : (rec.type === 'expense' ? '↓' : '↑')}}</text>
              </view>
              <view class="record-info">
                <text class="record-category {{rec.isRetract ? 'category-retract' : ''}}">{{rec.category}}</text>
                <text class="record-note {{rec.isRetract ? 'note-retract' : ''}}" wx:if="{{rec.note}}">{{rec.note}}</text>
              </view>
            </view>
            <text class="record-amount {{rec.type === 'expense' ? 'amount-expense' : 'amount-income'}} {{rec.isRetract ? 'amount-retract' : ''}}">
              ¥{{rec.amount}}
            </text>
          </view>
          <view class="retract-btn" bindtap="onRetract" data-id="{{rec.id}}" data-amount="{{rec.amount}}" data-type="{{rec.type}}" data-category="{{rec.category}}" data-note="{{rec.note}}" data-record-date="{{rec.recordDate}}" wx:if="{{!rec.isRetracted && !rec.isRetract}}">
            <text class="retract-icon">↺</text>
            <text class="retract-text">撤回</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{!loading && groupedRecords.length === 0}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无记录</text>
    <text class="empty-hint">当月还没有任何收支记录</text>
  </view>

  <!-- Bottom summary -->
  <view class="bottom-summary" wx:if="{{groupedRecords.length > 0}}">
    <view class="summary-item">
      <text class="summary-label">本月支出</text>
      <text class="summary-value expense">¥{{totalExpense}}</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <text class="summary-label">本月收入</text>
      <text class="summary-value income">¥{{totalIncome}}</text>
    </view>
  </view>

  <!-- Loading -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
