<view class="page">
  <!-- 装饰性背景光斑 -->
  <view class="bg-orb bg-orb--1"></view>
  <view class="bg-orb bg-orb--2"></view>
  <view class="bg-orb bg-orb--3"></view>

  <!-- 顶部：日剩余预算 + 日期 + 毒鸡汤 -->
  <view class="hero">
    <view class="hero-card">
      <view class="hero-main">
        <text class="hero-label">今日剩余预算</text>
        <text class="hero-amount {{remainTotal < 0 ? 'negative' : 'positive'}}">¥{{remainTotal}}</text>
        <text class="hero-date">{{month}}月{{day}}日 {{weekday}}</text>
      </view>
      <view class="hero-treasure">
        <!-- 透支：枯萎硬币堆 -->
        <view class="dead-coins" wx:if="{{isOverBudget}}">
          <view class="dead-coin dc-1"></view>
          <view class="dead-coin dc-2"></view>
          <view class="dead-coin dc-3"></view>
          <view class="dead-coin dc-4"></view>
          <view class="dead-coin dc-5"></view>
        </view>
        <!-- 正常：金元宝山 -->
        <block wx:else>
          <!-- 金光光晕 -->
          <view class="treasure-glow"></view>
          <!-- 浮动金粉粒子 -->
          <view class="gold-particles">
            <view class="particle p-1"></view>
            <view class="particle p-2"></view>
            <view class="particle p-3"></view>
            <view class="particle p-4"></view>
            <view class="particle p-5"></view>
          </view>
          <!-- 金元宝山 -->
          <view class="treasure-mountain">
            <view class="ingot" wx:for="{{ingots}}" wx:key="index"
              style="left:{{item.x}}rpx;top:{{item.y}}rpx;transform:rotate({{item.r}}deg) scale({{item.s}});z-index:{{item.z}};opacity:{{index < visibleIngots ? 1 : 0}}">
            </view>
          </view>
          <view class="spend-effect" wx:if="{{showFlyingAnimation}}">
            <view class="flying-ingot fi-1"></view>
            <view class="flying-ingot fi-2"></view>
            <view class="flying-ingot fi-3"></view>
            <view class="flying-ingot fi-4"></view>
            <view class="flying-ingot fi-5"></view>
            <view class="flying-coin fc-1"></view>
            <view class="flying-coin fc-2"></view>
            <view class="flying-coin fc-3"></view>
            <view class="flying-coin fc-4"></view>
            <view class="flying-coin fc-5"></view>
            <view class="spend-flash"></view>
          </view>
        </block>
        <!-- 透支时记账才飘出来 -->
        <view class="broke-effect" wx:if="{{showBrokeAnimation}}">
          <view class="broke-skull">
            <text class="skull-ghost">💀</text>
            <text class="broke-text">穷鬼别花了</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 家庭选择器 -->
  <!-- <view class="family-selector" wx:if="{{familyGroups.length > 0}}">
    <view class="family-selector-header" bindtap="onToggleFamilySelector">
      <view class="family-selector-left">
        <view class="family-icon">🏠</view>
        <text class="family-label">当前家庭:</text>
      </view>
      <text class="family-name">{{selectedFamilyIndex >= 0 ? familyGroups[selectedFamilyIndex].name : '个人记账'}}</text>
      <text class="selector-arrow {{showFamilySelector ? 'arrow-up' : ''}}">▼</text>
    </view>
    <view class="family-dropdown" wx:if="{{showFamilySelector}}">
      <view class="family-option {{selectedFamilyIndex === -1 ? 'active' : ''}}" data-index="-1" bindtap="onSwitchFamily">
        <view class="family-option-indicator"></view>
        <text>个人记账</text>
      </view>
      <view wx:for="{{familyGroups}}" wx:key="id" class="family-option {{selectedFamilyIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSwitchFamily">
        <view class="family-option-indicator"></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view> -->

  <!-- 统计卡片 -->
  <view class="summary-card">
    <view class="summary-card-glow"></view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">今日预算</text>
        <text class="stat-value">¥{{budgetTotal}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">今日花销</text>
        <text class="stat-value expense today">¥{{actualTotal}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">本月花销</text>
        <text class="stat-value expense">¥{{monthActualTotal}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-label">本月剩余</text>
        <text class="stat-value {{monthRemainTotal < 0 ? 'expense' : 'positive'}}">¥{{monthRemainTotal}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷记账 -->
  <view class="quick-section">
    <view class="section-header">
      <view class="section-title-icon">⚡</view>
      <text class="section-title">快捷记账</text>
    </view>
    <view class="quick-grid">
      <view
        wx:for="{{quickItems}}"
        wx:key="key"
        class="quick-item {{item.isOther ? 'quick-item--other' : ''}}"
      >
        <view class="quick-item-header" wx:if="{{!item.isOther}}">
          <view class="quick-icon">{{item.icon}}</view>
          <text class="quick-label">{{item.label}}</text>
          <view class="quick-amount-badge">
            <text class="quick-amount">¥{{item.currentAmount}}</text>
          </view>
        </view>
        <view class="quick-calibrate" wx:if="{{!item.isOther}}">
          <view class="calibrate-btn calibrate-btn--neg" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="-5" catchtap="onCalibrate">-5</view>
          <view class="calibrate-btn calibrate-btn--neg" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="-1" catchtap="onCalibrate">-1</view>
          <view class="calibrate-btn calibrate-btn--pos" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="+1" catchtap="onCalibrate">+1</view>
          <view class="calibrate-btn calibrate-btn--pos" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="+5" catchtap="onCalibrate">+5</view>
        </view>
        <button
          class="quick-record-btn {{item.isOther ? 'quick-record-btn--other' : ''}}"
          hover-class="quick-record-btn--active"
          data-key="{{item.key}}"
          data-amount="{{item.currentAmount}}"
          data-isOther="{{item.isOther}}"
          bindtap="onTapQuickRecord"
          wx:if="{{!item.isOther}}"
        >记一笔</button>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮区域 -->
  <view class="action-buttons-section">
    <view class="section-header">
      <view class="section-title-icon">📝</view>
      <text class="section-title">更多操作</text>
    </view>
    <view class="action-btn-group">
      <button class="action-btn action-btn--expense" hover-class="action-btn--active" bindtap="onTapQuickRecord" data-key="other" data-amount="0" data-isOther="true">
        <text class="action-btn-icon">💰</text>
        <text class="action-btn-text">自定义消费金额</text>
      </button>
      <view class="action-btn-divider"></view>
      <button class="action-btn action-btn--income" hover-class="action-btn--active" bindtap="onOpenIncomeModal">
        <text class="action-btn-icon">💵</text>
        <text class="action-btn-text">收入登记</text>
      </button>
    </view>
  </view>

  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <!-- "其他"项记账模态框 -->
  <view class="modal-overlay" wx:if="{{showOtherModal}}" bindtap="onCloseOtherModal">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">自定义消费金额</text>
        <view class="modal-close" bindtap="onCloseOtherModal">✕</view>
      </view>

      <view class="modal-body">
        <!-- 月度分类按钮组 -->
        <view class="category-group" wx:if="{{monthlyCategories.length > 0}}">
          <text class="category-group-title">月度预算</text>
          <view class="category-buttons">
            <view
              class="category-btn {{otherForm.selectedCategory && otherForm.selectedCategory.key === item.key ? 'active' : ''}}"
              wx:for="{{monthlyCategories}}"
              wx:key="key"
              data-index="{{index}}"
              data-key="{{item.key}}"
              data-label="{{item.label}}"
              data-icon="{{item.icon}}"
              data-defaultAmount="{{item.defaultAmount}}"
              bindtap="onSelectCategory"
            >
              <text class="category-btn-icon">{{item.icon}}</text>
              <text class="category-btn-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 年度分类按钮组 -->
        <view class="category-group" wx:if="{{yearlyCategories.length > 0}}">
          <text class="category-group-title">年度预算</text>
          <view class="category-buttons">
            <view
              class="category-btn {{otherForm.selectedCategory && otherForm.selectedCategory.key === item.key ? 'active' : ''}}"
              wx:for="{{yearlyCategories}}"
              wx:key="key"
              data-index="{{index}}"
              data-key="{{item.key}}"
              data-label="{{item.label}}"
              data-icon="{{item.icon}}"
              data-defaultAmount="{{item.defaultAmount}}"
              bindtap="onSelectCategory"
            >
              <text class="category-btn-icon">{{item.icon}}</text>
              <text class="category-btn-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 其他按钮 -->
        <view class="category-group">
          <text class="category-group-title">其他</text>
          <view class="category-buttons">
            <view
              class="category-btn {{otherForm.selectedCategory && otherForm.selectedCategory.key === 'other' ? 'active' : ''}}"
              data-key="other"
              data-label="其他"
              data-icon="➕"
              data-defaultAmount="0"
              bindtap="onSelectCategory"
            >
              <text class="category-btn-icon">➕</text>
              <text class="category-btn-text">其他</text>
            </view>
          </view>
        </view>

        <!-- 金额和备注输入 -->
        <view class="form-section" wx:if="{{otherForm.selectedCategory}}">
          <view class="form-item">
            <text class="form-label">金额 (元) <text class="required">*</text></text>
            <input
              class="form-input"
              type="digit"
              placeholder="请输入金额"
              value="{{otherForm.amount}}"
              data-field="amount"
              bindinput="onOtherFormInput"
            />
          </view>
          <view class="form-item" wx:if="{{otherForm.selectedCategory.key === 'other'}}">
            <text class="form-label">备注 <text class="required">*</text></text>
            <input
              class="form-input"
              type="text"
              placeholder="请输入备注"
              value="{{otherForm.note}}"
              data-field="note"
              bindinput="onOtherFormInput"
            />
          </view>
          <view class="form-item" wx:if="{{otherForm.selectedCategory.key !== 'other'}}">
            <text class="form-label">备注 (可选)</text>
            <input
              class="form-input"
              type="text"
              placeholder="请输入备注"
              value="{{otherForm.note}}"
              data-field="note"
              bindinput="onOtherFormInput"
            />
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn modal-btn--cancel" bindtap="onCloseOtherModal">取消</button>
        <button class="modal-btn modal-btn--confirm {{!otherForm.selectedCategory || !otherForm.amount ? 'disabled' : ''}}" bindtap="onSaveOtherRecord">确定</button>
      </view>
    </view>
  </view>

  <!-- 收入登记模态框 -->
  <view class="modal-overlay" wx:if="{{showIncomeModal}}" bindtap="onCloseIncomeModal">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">收入登记</text>
        <view class="modal-close" bindtap="onCloseIncomeModal">✕</view>
      </view>

      <view class="modal-body">
        <view class="category-group">
          <text class="category-group-title">选择收入来源</text>
          <view class="category-buttons">
            <view
              class="category-btn income-category-btn {{selectedIncomeCategory && selectedIncomeCategory.key === item.category_key ? 'active' : ''}}"
              wx:for="{{incomeCategories}}"
              wx:key="id"
              data-key="{{item.category_key}}"
              data-label="{{item.label}}"
              data-icon="{{item.icon}}"
              data-defaultAmount="{{item.default_amount}}"
              bindtap="onSelectIncomeCategory"
            >
              <text class="category-btn-icon">{{item.icon || '💰'}}</text>
              <text class="category-btn-text">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="form-section" wx:if="{{selectedIncomeCategory}}">
          <view class="form-item">
            <text class="form-label">金额 (元) <text class="required">*</text></text>
            <input
              class="form-input"
              type="digit"
              placeholder="请输入金额"
              value="{{incomeForm.amount}}"
              data-field="amount"
              bindinput="onIncomeFormInput"
            />
          </view>
          <view class="form-item">
            <text class="form-label">备注 (可选)</text>
            <input
              class="form-input"
              type="text"
              placeholder="请输入备注"
              value="{{incomeForm.note}}"
              data-field="note"
              bindinput="onIncomeFormInput"
            />
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn modal-btn--cancel" bindtap="onCloseIncomeModal">取消</button>
        <button class="modal-btn modal-btn--confirm income-confirm-btn {{!selectedIncomeCategory || !incomeForm.amount ? 'disabled' : ''}}" bindtap="onSaveIncomeRecord">确定登记</button>
      </view>
    </view>
  </view>
</view>
