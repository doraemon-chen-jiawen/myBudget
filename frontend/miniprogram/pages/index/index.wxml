<view class="page">
  <!-- 顶部：日剩余预算 + 日期 + 毒鸡汤 -->
  <view class="hero">
    <view class="hero-main">
      <text class="hero-label">日剩余预算</text>
      <text class="hero-amount">¥{{remainTotal}}</text>
      <text class="hero-date">{{month}}月{{day}}日 {{weekday}}</text>
    </view>
    <text class="hero-quote {{quoteType}}">{{dailyQuote}}</text>
  </view>

  <!-- 家庭选择器 -->
  <view class="family-selector" wx:if="{{familyGroups.length > 0}}">
    <view class="family-selector-header" bindtap="onToggleFamilySelector">
      <text class="family-label">当前家庭:</text>
      <text class="family-name">{{selectedFamilyIndex >= 0 ? familyGroups[selectedFamilyIndex].name : '个人记账'}}</text>
      <text class="selector-arrow">{{showFamilySelector ? '▲' : '▼'}}</text>
    </view>
    <view class="family-dropdown" wx:if="{{showFamilySelector}}">
      <view class="family-option {{selectedFamilyIndex === -1 ? 'active' : ''}}" data-index="-1" bindtap="onSwitchFamily">
        个人记账
      </view>
      <view wx:for="{{familyGroups}}" wx:key="id" class="family-option {{selectedFamilyIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onSwitchFamily">
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="summary-card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">今日预算</text>
        <text class="stat-value">¥{{budgetTotal}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">今日花销</text>
        <text class="stat-value expense">¥{{actualTotal}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">本月消费</text>
        <text class="stat-value expense">¥{{monthActualTotal}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">本月剩余</text>
        <text class="stat-value">¥{{monthRemainTotal}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷记账 -->
  <view class="quick-section">
    <view class="section-header">
      <text class="section-title">快捷记账</text>
    </view>
    <view class="quick-grid">
      <view
        wx:for="{{quickItems}}"
        wx:key="key"
        class="quick-item"
      >
        <view class="quick-btn">
          <text class="quick-label">{{item.label}}</text>
          <text class="quick-amount">¥{{item.currentAmount}}</text>
        </view>
        <view class="quick-calibrate">
          <view class="calibrate-btn calibrate-btn--neg" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="-5" catchtap="onCalibrate">-5</view>
          <view class="calibrate-btn calibrate-btn--neg" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="-1" catchtap="onCalibrate">-1</view>
          <view class="calibrate-btn calibrate-btn--pos" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="+1" catchtap="onCalibrate">+1</view>
          <view class="calibrate-btn calibrate-btn--pos" hover-class="calibrate-btn--active" data-key="{{item.key}}" data-delta="+5" catchtap="onCalibrate">+5</view>
        </view>
        <button
          class="quick-record-btn"
          hover-class="quick-record-btn--active"
          data-key="{{item.key}}"
          data-amount="{{item.currentAmount}}"
          bindtap="onTapQuickRecord"
        >记一笔</button>
      </view>
    </view>
  </view>

  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
