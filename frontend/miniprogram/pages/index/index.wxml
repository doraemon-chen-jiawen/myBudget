<view class="page">
  <view class="header-card card">
    <view class="header-top">
      <text class="page-title">今日概览</text>
      <text class="today">{{today}}</text>
    </view>
    <view class="kpi-grid">
      <view class="kpi-item">
        <text class="kpi-label">今日预算总额</text>
        <text class="kpi-value">¥{{budgetTotal}}</text>
      </view>
      <view class="kpi-item">
        <text class="kpi-label">今日实际花销</text>
        <text class="kpi-value expense">¥{{actualTotal}}</text>
      </view>
      <view class="kpi-item">
        <text class="kpi-label">今日剩余预算</text>
        <text class="kpi-value remain">¥{{remainTotal}}</text>
      </view>
    </view>
  </view>

  <view class="quick-card card">
    <view class="section-title">快捷记账</view>
    <view class="quick-grid">
      <view
        wx:for="{{quickItems}}"
        wx:key="key"
        class="quick-item"
      >
        <button
          class="quick-btn"
          data-key="{{item.key}}"
          bindtap="onTapQuickRecord"
        >
          {{item.label}} · ¥{{item.amount}}
        </button>
        <text class="quick-count">今日已点 {{item.count}} 次</text>
      </view>
    </view>
  </view>
</view>
