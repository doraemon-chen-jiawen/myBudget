<view class="page">
  <view class="decor-dot decor-dot-1"></view>
  <view class="decor-dot decor-dot-2"></view>
  <view class="decor-line decor-line-1"></view>

  <view class="date-hero">
    <view class="decor-circle decor-circle-1"></view>
    <view class="decor-circle decor-circle-2"></view>
    <text class="date-day">{{day}}</text>
    <view class="date-meta">
      <text class="date-month">{{month}}月</text>
      <text class="date-dot">·</text>
      <text class="date-weekday">{{weekday}}</text>
    </view>
  </view>

  <view class="summary-card">
    <view class="card-header">
      <text class="card-title">今日概览</text>
      <image class="card-icon" mode="aspectFit" />
    </view>

    <view class="budget-display">
      <text class="budget-label">今日预算</text>
      <text class="budget-amount">¥{{budgetTotal}}</text>
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">实际花销</text>
        <text class="stat-value expense">¥{{actualTotal}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">剩余预算</text>
        <text class="stat-value remain">¥{{remainTotal}}</text>
      </view>
    </view>
  </view>

  <view class="quick-section">
    <view class="section-header">
      <text class="section-title">快捷记账</text>
    </view>
    <view class="quick-grid">
      <view
        wx:for="{{quickItems}}"
        wx:key="key"
        class="quick-item"
      >
        <button
          class="quick-btn"
          data-key="{{item.key}}"
          bindtap="onTapQuickRecord"
        >
          <text class="quick-label">{{item.label}}</text>
          <text class="quick-amount">¥{{item.amount}}</text>
          <text class="quick-count">今日已点 {{item.count}} 次</text>
        </button>
      </view>
    </view>
  </view>
</view>
