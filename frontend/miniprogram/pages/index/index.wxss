@import "../../app.wxss";

page {
  background: linear-gradient(175deg, #c8e6d0 0%, #dff0e5 35%, #f5f0ea 100%);
}

/* ===== Page Shell ===== */

.page {
  min-height: 100vh;
}

/* ===== Hero ===== */

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 60rpx 40rpx 32rpx;
}

.hero-main {
  flex-shrink: 0;
}

.hero-label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-amount {
  display: block;
  font-size: 96rpx;
  font-weight: 800;
  color: var(--color-primary-deepdark);
  line-height: 1;
  letter-spacing: -4rpx;
}

.hero-date {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

.hero-quote {
  max-width: 300rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: right;
  color: var(--color-primary-dark);
  font-family: cursive;
}

.hero-quote.bad {
  color: var(--color-warm);
}

/* ===== Summary Card ===== */

.summary-card {
  position: relative;
  margin: 0 28rpx 32rpx;
  padding: 36rpx 28rpx;
  background: rgba(255, 255, 255, 0.45);
  border-radius: var(--radius-card);
}

.summary-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-primary));
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}

.stats-row {
  display: flex;
  gap: 12rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.stat-value.expense {
  color: #C07030;
}

/* ===== Quick Section ===== */

.quick-section {
  margin: 48rpx 28rpx 0;
}

.section-header {
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--color-text-main);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-item {
  padding: 28rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-card);
}

.quick-btn {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--color-text-main);
  font-weight: 600;
  line-height: 1.4;
}

.quick-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary-dark);
  line-height: 1;
  letter-spacing: -1rpx;
}

.quick-calibrate {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.calibrate-btn {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 14rpx;
  transition: opacity 0.15s ease;
}

.calibrate-btn--pos {
  background: rgba(255, 179, 138, 0.2);
  color: #C07030;
}

.calibrate-btn--neg {
  background: rgba(111, 207, 151, 0.15);
  color: var(--color-primary-dark);
}

.calibrate-btn:active {
  opacity: 0.5;
}

.calibrate-btn--active {
  opacity: 0.5;
  transform: scale(0.93);
}

.quick-record-btn {
  width: 100% !important;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  padding: 0;
  margin: 0;
  letter-spacing: 2rpx;
}

.quick-record-btn::after {
  display: none;
}

.quick-record-btn:active {
  opacity: 0.85;
}

.quick-record-btn--active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ===== Loading ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(111, 207, 151, 0.15);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== Family Selector ===== */

.family-selector {
  margin: 0 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  overflow: hidden;
}

.family-selector-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.family-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-right: 16rpx;
}

.family-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.selector-arrow {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.family-dropdown {
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.family-option {
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.family-option:last-child {
  border-bottom: none;
}

.family-option.active {
  background: rgba(111, 207, 151, 0.1);
  color: var(--color-primary);
  font-weight: 600;
}
