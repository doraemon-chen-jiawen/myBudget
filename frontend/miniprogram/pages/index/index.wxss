@import "../../app.wxss";

.page {
  background: linear-gradient(170deg, #d4edda 0%, #e8f5e9 25%, #f1f8e9 50%, #fdf8f0 80%, #fffaf5 100%);
}

/* ===== Page Shell ===== */

.page {
  min-height: 100vh;
  position: relative;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ===== Decorative Background Orbs ===== */

.bg-orb {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-orb--1 {
  width: 500rpx;
  height: 500rpx;
  top: -120rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(111, 207, 151, 0.18) 0%, transparent 70%);
}

.bg-orb--2 {
  width: 400rpx;
  height: 400rpx;
  top: 45%;
  left: -140rpx;
  background: radial-gradient(circle, rgba(86, 204, 242, 0.12) 0%, transparent 70%);
}

.bg-orb--3 {
  width: 350rpx;
  height: 350rpx;
  bottom: 5%;
  right: -80rpx;
  background: radial-gradient(circle, rgba(255, 179, 138, 0.14) 0%, transparent 70%);
}

/* ===== Hero ===== */

.hero {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx 0;
}

.hero-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 48rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 36rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 40rpx rgba(111, 207, 151, 0.1), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.hero-main {
  flex-shrink: 0;
}

.hero-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.hero-amount {
  display: block;
  font-size: 88rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
}

.hero-amount.positive {
  background: linear-gradient(135deg, var(--color-primary-deepdark) 0%, var(--color-primary-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-amount.negative {
  color: #FF6B6B
}

.hero-date {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* ===== Gold Ingot Mountain ===== */

.hero-treasure {
  max-width: 260rpx;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  padding-bottom: 8rpx;
}

.treasure-glow {
  position: absolute;
  bottom: -20rpx;
  width: 280rpx;
  height: 180rpx;
  background: radial-gradient(ellipse at center bottom, rgba(255, 215, 0, 0.3) 0%, rgba(255, 180, 50, 0.15) 30%, rgba(255, 140, 0, 0.05) 50%, transparent 70%);
  pointer-events: none;
  animation: treasureGlow 2s ease-in-out infinite;
}

@keyframes treasureGlow {
  0%, 100% { opacity: 0.8; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.treasure-mountain {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.ingot {
  position: absolute;
  width: 36rpx;
  height: 22rpx;
  background: linear-gradient(145deg, #FFE566 0%, #FFD700 20%, #FFC125 50%, #DAA520 80%, #B8860B 100%);
  border-radius: 3rpx 3rpx 50% 50%;
  box-shadow: 
    0 3rpx 8rpx rgba(184, 134, 11, 0.6),
    0 6rpx 16rpx rgba(255, 215, 0, 0.3),
    inset 0 2rpx 4rpx rgba(255, 255, 220, 0.6),
    inset 0 -2rpx 3rpx rgba(139, 90, 43, 0.4);
  transition: all 0.5s ease;
  filter: drop-shadow(0 0 6rpx rgba(255, 215, 0, 0.5));
}

.ingot::before {
  content: '宝';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 12rpx;
  font-weight: bold;
  color: rgba(139, 90, 43, 0.5);
  font-family: serif;
}

.ingot::after {
  content: '';
  position: absolute;
  top: 15%;
  left: 15%;
  width: 70%;
  height: 28%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
  border-radius: 50%;
  animation: ingotShine 3s ease-in-out infinite;
}

@keyframes ingotShine {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ===== Gold Particles ===== */

.gold-particles {
  position: absolute;
  top: -20rpx;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: visible;
}

.particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: radial-gradient(circle, #FFE566 0%, #FFD700 50%, #DAA520 100%);
  border-radius: 50%;
  opacity: 0;
  box-shadow: 0 0 6rpx rgba(255, 215, 0, 0.8), 0 0 12rpx rgba(255, 200, 0, 0.4);
}

.p-1 {
  top: 15%;
  left: 20%;
  animation: particleFloat1 2.5s ease-in-out infinite;
}

.p-2 {
  top: 25%;
  right: 15%;
  animation: particleFloat2 3s ease-in-out infinite;
}

.p-3 {
  top: 10%;
  left: 50%;
  animation: particleFloat3 2.8s ease-in-out infinite;
}

.p-4 {
  top: 30%;
  left: 10%;
  animation: particleFloat4 3.2s ease-in-out infinite;
}

.p-5 {
  top: 20%;
  right: 25%;
  animation: particleFloat5 2.6s ease-in-out infinite;
}

@keyframes particleFloat1 {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
  20% { opacity: 0.9; }
  50% { opacity: 0.7; transform: translateY(-40rpx) scale(1); }
  80% { opacity: 0.4; }
}

@keyframes particleFloat2 {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.3); }
  15% { opacity: 0.8; }
  50% { opacity: 0.6; transform: translateY(-55rpx) scale(0.9); }
  85% { opacity: 0.3; }
}

@keyframes particleFloat3 {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.6); }
  25% { opacity: 1; }
  50% { opacity: 0.8; transform: translateY(-35rpx) scale(1.1); }
  75% { opacity: 0.5; }
}

@keyframes particleFloat4 {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.4); }
  18% { opacity: 0.85; }
  50% { opacity: 0.65; transform: translateY(-48rpx) scale(0.85); }
  82% { opacity: 0.35; }
}

@keyframes particleFloat5 {
  0%, 100% { opacity: 0; transform: translateY(0) scale(0.55); }
  22% { opacity: 0.95; }
  50% { opacity: 0.75; transform: translateY(-42rpx) scale(1.05); }
  78% { opacity: 0.45; }
}

/* ===== Dead Coins (Over Budget) ===== */

.dead-coins {
  position: relative;
  width: 130rpx;
  height: 110rpx;
  animation: coinsDrop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes coinsDrop {
  0% { opacity: 0; transform: translateY(-16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.dead-coin {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(145deg, #B8B0A0 0%, #9A9285 30%, #7A7568 60%, #5A5548 100%);
  box-shadow: 
    0 2rpx 6rpx rgba(0, 0, 0, 0.2),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.1),
    inset 0 -2rpx 3rpx rgba(0, 0, 0, 0.2);
  opacity: 0.6;
}

.dead-coin::before {
  content: '';
  position: absolute;
  top: 8%;
  left: 8%;
  width: 84%;
  height: 84%;
  border-radius: 50%;
  background: linear-gradient(145deg, transparent 40%, rgba(0, 0, 0, 0.15) 100%);
}

.dead-coin::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 55%;
  height: 55%;
  border: 1.5rpx solid rgba(80, 75, 65, 0.3);
  border-radius: 50%;
}

.dc-1 {
  width: 32rpx;
  height: 32rpx;
  left: 14rpx;
  bottom: 6rpx;
  transform: rotate(-25deg);
  opacity: 0.65;
}

.dc-2 {
  width: 30rpx;
  height: 30rpx;
  left: 42rpx;
  bottom: 2rpx;
  transform: rotate(15deg);
  opacity: 0.55;
}

.dc-3 {
  width: 28rpx;
  height: 28rpx;
  left: 68rpx;
  bottom: 8rpx;
  transform: rotate(-10deg);
  opacity: 0.5;
}

.dc-4 {
  width: 26rpx;
  height: 26rpx;
  left: 30rpx;
  bottom: 30rpx;
  transform: rotate(35deg);
  opacity: 0.4;
}

.dc-5 {
  width: 22rpx;
  height: 22rpx;
  left: 56rpx;
  bottom: 26rpx;
  transform: rotate(-40deg);
  opacity: 0.35;
}

/* 硬币裂纹效果 - 使用伪元素模拟 */
.dc-2::before,
.dc-3::before {
  content: '';
  position: absolute;
  top: 20%;
  left: 60%;
  width: 30%;
  height: 2rpx;
  background: rgba(60, 55, 45, 0.4);
  transform: rotate(45deg);
  border-radius: 1rpx;
}

/* ===== Broke Effect — Skull Float ===== */

.broke-effect {
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  right: -40rpx;
  height: 80rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
  z-index: 20;
}

.broke-skull {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  animation: skullFloat 1.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.skull-ghost {
  font-size: 48rpx;
  line-height: 1;
  filter: grayscale(0.3) brightness(0.85);
}

.broke-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

@keyframes skullFloat {
  0% { opacity: 0; transform: translateY(20rpx) scale(0.4); }
  20% { opacity: 1; transform: translateY(-8rpx) scale(1.1); }
  35% { transform: translateY(-4rpx) scale(1) rotate(6deg); }
  50% { transform: translateY(-16rpx) scale(1) rotate(-4deg); }
  65% { opacity: 1; transform: translateY(-28rpx) scale(0.95) rotate(2deg); }
  100% { opacity: 0; transform: translateY(-60rpx) scale(0.7) rotate(0deg); }
}

/* ===== Spend Effect ===== */

.spend-effect {
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  right: -40rpx;
  bottom: -40rpx;
  pointer-events: none;
  z-index: 20;
}

.flying-ingot {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 30rpx;
  height: 20rpx;
  background: linear-gradient(180deg, #FFE566 0%, #FFD700 30%, #FFC125 60%, #DAA520 100%);
  border-radius: 3rpx 3rpx 50% 50%;
  box-shadow: 
    0 0 20rpx rgba(255, 215, 0, 0.95),
    0 0 40rpx rgba(255, 180, 0, 0.5),
    0 0 60rpx rgba(255, 140, 0, 0.25);
  filter: drop-shadow(0 0 8rpx rgba(255, 215, 0, 0.8));
}

.flying-coin {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFFACD, #FFE566, #FFD700, #DAA520);
  box-shadow: 
    0 0 12rpx rgba(255, 215, 0, 0.95),
    0 0 24rpx rgba(255, 180, 0, 0.5),
    inset 0 -2rpx 4rpx rgba(218, 165, 32, 0.4);
  filter: drop-shadow(0 0 6rpx rgba(255, 215, 0, 0.8));
}

.fi-1 { animation: flyOut1 1s cubic-bezier(0.15, 0.85, 0.3, 1) forwards; }
.fi-2 { animation: flyOut2 0.95s cubic-bezier(0.15, 0.85, 0.3, 1) forwards; animation-delay: 0.06s; }
.fi-3 { animation: flyOut3 1.05s cubic-bezier(0.15, 0.85, 0.3, 1) forwards; animation-delay: 0.1s; }
.fi-4 { animation: flyOut4 0.9s cubic-bezier(0.15, 0.85, 0.3, 1) forwards; animation-delay: 0.16s; }
.fi-5 { animation: flyOut5 0.85s cubic-bezier(0.15, 0.85, 0.3, 1) forwards; animation-delay: 0.22s; }

.fc-1 { animation: coinFly1 0.7s ease-out forwards; }
.fc-2 { animation: coinFly2 0.65s ease-out forwards; animation-delay: 0.05s; }
.fc-3 { animation: coinFly3 0.75s ease-out forwards; animation-delay: 0.12s; }
.fc-4 { animation: coinFly4 0.6s ease-out forwards; animation-delay: 0.18s; }
.fc-5 { animation: coinFly5 0.7s ease-out forwards; animation-delay: 0.24s; }

.spend-flash {
  position: absolute;
  inset: -30rpx;
  background: radial-gradient(circle, rgba(255, 200, 50, 0.5), rgba(255, 150, 50, 0.25), rgba(255, 80, 80, 0.1), transparent);
  animation: flashBang 0.8s ease-out forwards;
  border-radius: 50%;
}

@keyframes flashBang {
  0% { opacity: 1; transform: scale(0.4); filter: brightness(1.5); }
  20% { opacity: 0.95; transform: scale(1.2); filter: brightness(1.3); }
  100% { opacity: 0; transform: scale(2.2); filter: brightness(0.8); }
}

@keyframes flyOut1 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.5) rotate(0deg); }
  25% { opacity: 1; filter: brightness(1.3); }
  100% { opacity: 0; transform: translate(calc(-50% + 110rpx), calc(-50% - 170rpx)) scale(0.25) rotate(540deg); }
}

@keyframes flyOut2 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.4) rotate(0deg); }
  25% { opacity: 1; filter: brightness(1.3); }
  100% { opacity: 0; transform: translate(calc(-50% - 100rpx), calc(-50% - 150rpx)) scale(0.25) rotate(-480deg); }
}

@keyframes flyOut3 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.6) rotate(0deg); }
  25% { opacity: 1; filter: brightness(1.3); }
  100% { opacity: 0; transform: translate(calc(-50% + 25rpx), calc(-50% - 190rpx)) scale(0.25) rotate(360deg); }
}

@keyframes flyOut4 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3) rotate(0deg); }
  25% { opacity: 1; filter: brightness(1.3); }
  100% { opacity: 0; transform: translate(calc(-50% - 130rpx), calc(-50% - 110rpx)) scale(0.25) rotate(-600deg); }
}

@keyframes flyOut5 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.4) rotate(0deg); }
  25% { opacity: 1; filter: brightness(1.3); }
  100% { opacity: 0; transform: translate(calc(-50% + 90rpx), calc(-50% - 160rpx)) scale(0.25) rotate(420deg); }
}

@keyframes coinFly1 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: brightness(1.2); }
  100% { opacity: 0; transform: translate(calc(-50% + 65rpx), calc(-50% - 120rpx)) scale(0.3); }
}

@keyframes coinFly2 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: brightness(1.2); }
  100% { opacity: 0; transform: translate(calc(-50% - 75rpx), calc(-50% - 95rpx)) scale(0.3); }
}

@keyframes coinFly3 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: brightness(1.2); }
  100% { opacity: 0; transform: translate(calc(-50% + 45rpx), calc(-50% - 140rpx)) scale(0.3); }
}

@keyframes coinFly4 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: brightness(1.2); }
  100% { opacity: 0; transform: translate(calc(-50% - 55rpx), calc(-50% - 125rpx)) scale(0.3); }
}

@keyframes coinFly5 {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: brightness(1.2); }
  100% { opacity: 0; transform: translate(calc(-50% + 95rpx), calc(-50% - 65rpx)) scale(0.3); }
}

/* ===== Family Selector ===== */

.family-selector {
  position: relative;
  z-index: 100;
  margin: 24rpx 32rpx;
}

.family-selector-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  backdrop-filter: blur(16px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.family-selector-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.family-selector-left {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}

.family-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.family-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.family-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.selector-arrow {
  font-size: 20rpx;
  color: var(--color-text-hint);
  transition: transform 0.3s ease;
}

.selector-arrow.arrow-up {
  transform: rotate(180deg);
}

.family-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12), 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: dropdownSlide 0.25s ease;
}

@keyframes dropdownSlide {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.family-option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: background 0.2s ease;
}

.family-option:last-child {
  border-bottom: none;
}

.family-option-indicator {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: transparent;
  margin-right: 16rpx;
  transition: background 0.2s ease;
}

.family-option.active {
  background: rgba(111, 207, 151, 0.08);
  color: var(--color-primary);
  font-weight: 600;
}

.family-option.active .family-option-indicator {
  background: var(--color-primary);
}

/* ===== Summary Card ===== */

.summary-card {
  position: relative;
  z-index: 1;
  margin: 8rpx 32rpx 32rpx;
  padding: 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: var(--radius-card);
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 32rpx rgba(111, 207, 151, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.summary-card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-primary));
  background-size: 200% 100%;
  animation: glowSlide 4s ease infinite;
}

@keyframes glowSlide {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.08), transparent);
  flex-shrink: 0;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.stat-value.expense {
  color: #FFB38A;
}
.stat-value.expense.today {
  color: #FF6B6B;
}

.stat-value.positive {
  color: var(--color-primary-dark);
}

/* ===== Quick Section ===== */

.quick-section {
  position: relative;
  z-index: 1;
  margin: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  color: var(--color-text-main);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.quick-item {
  padding: 28rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-card);
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: box-shadow 0.3s ease, transform 0.2s ease;
}

.quick-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.quick-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quick-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--color-text-main);
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
}

.quick-amount-badge {
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.15), rgba(86, 204, 242, 0.1));
  border-radius: 20rpx;
}

.quick-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary-dark);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.quick-calibrate {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.calibrate-btn {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.calibrate-btn--pos {
  background: rgba(255, 179, 138, 0.18);
  color: #C07030;
  border: 1rpx solid rgba(255, 179, 138, 0.2);
}

.calibrate-btn--neg {
  background: rgba(111, 207, 151, 0.12);
  color: var(--color-primary-dark);
  border: 1rpx solid rgba(111, 207, 151, 0.15);
}

.calibrate-btn:active {
  opacity: 0.5;
}

.calibrate-btn--active {
  opacity: 0.5;
  transform: scale(0.9);
}

.quick-record-btn {
  width: 100% !important;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  border: none;
  border-radius: 18rpx;
  padding: 0;
  margin: 0;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
  transition: all 0.2s ease;
}

.quick-record-btn::after {
  display: none;
}

.quick-record-btn:active {
  opacity: 0.85;
}

.quick-record-btn--active {
  opacity: 0.85;
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(111, 207, 151, 0.2);
}

.quick-item--other {
  display: none
}

.quick-record-btn--other {
  background: none;
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 138, 0.3);
  border: 1px solid var(--color-warm);
  color: var(--color-warm);
}

/* ===== Modal ===== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  backdrop-filter: blur(4px);
  animation: modalFadeIn 0.2s ease;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.12), 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: modalSlideUp 0.25s ease;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-main);
  letter-spacing: 2rpx;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--color-text-hint);
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.modal-close:active {
  background: rgba(0, 0, 0, 0.05);
  opacity: 0.7;
}

.modal-body {
  padding: 32rpx;
  max-height: 900rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.form-section-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 分类按钮组 */
.category-group {
  margin-bottom: 24rpx;
}

.category-group-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.category-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.category-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  transition: all 0.2s ease;
  min-height: 64rpx;
}

.category-btn:active {
  transform: scale(0.98);
}

.category-btn.active {
  background: rgba(111, 207, 151, 0.15);
  border-color: rgba(111, 207, 151, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(111, 207, 151, 0.2);
}

.category-btn-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.category-btn-text {
  font-size: 24rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
}


.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-input:focus {
  background: rgba(255, 255, 255, 0.9);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(111, 207, 151, 0.1);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 0;
  margin: 0;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.modal-btn::after {
  display: none;
}

.modal-btn--cancel {
  background: rgba(0, 0, 0, 0.04);
  color: var(--color-text-secondary);
}

.modal-btn--cancel:active {
  background: rgba(0, 0, 0, 0.08);
}

.modal-btn--confirm {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
}

.modal-btn--confirm:active {
  opacity: 0.85;
}

.modal-btn--confirm.disabled {
  background: rgba(0, 0, 0, 0.06);
  color: var(--color-text-hint);
  box-shadow: none;
  pointer-events: none;
}

/* ===== Loading ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8px);
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(111, 207, 151, 0.15);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== 收入登记入口 ===== */

.income-entry-card {
  position: relative;
  z-index: 1;
  margin: 24rpx 32rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, rgba(39, 174, 96, 0.12) 0%, rgba(46, 204, 113, 0.08) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(39, 174, 96, 0.2);
  transition: all 0.2s ease;
}

.income-entry-card:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(39, 174, 96, 0.18) 0%, rgba(46, 204, 113, 0.12) 100%);
}

.income-entry-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.income-entry-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #27AE60;
  letter-spacing: 2rpx;
}

.income-entry-arrow {
  font-size: 28rpx;
  color: #27AE60;
  opacity: 0.6;
}

/* 收入分类按钮特殊样式 */
.income-category-btn.active {
  background: rgba(39, 174, 96, 0.15) !important;
  border-color: rgba(39, 174, 96, 0.4) !important;
  box-shadow: 0 4rpx 12rpx rgba(39, 174, 96, 0.2);
}

.income-confirm-btn {
  background: linear-gradient(135deg, #27AE60 0%, #2ECC71 100%) !important;
  box-shadow: 0 6rpx 20rpx rgba(39, 174, 96, 0.3) !important;
}

/* ===== 底部操作按钮区域 ===== */

.action-buttons-section {
  position: relative;
  z-index: 1;
  margin: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-btn-group {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 24rpx;
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 20rpx rgba(111, 207, 151, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 20rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  margin: 0;
  transition: all 0.2s ease;
}

.action-btn::after {
  display: none;
}

.action-btn--active {
  opacity: 0.7;
  transform: scale(0.98);
}

.action-btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.action-btn--expense .action-btn-text {
  color: var(--color-warm);
}

.action-btn--income .action-btn-text {
  color: #27AE60;
}

.action-btn-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.08), transparent);
}
