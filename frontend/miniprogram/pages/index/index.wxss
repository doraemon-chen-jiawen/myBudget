@import "../../app.wxss";

page {
  background: var(--color-bg);
}

.page {
  min-height: 100vh;
  padding: 0 0 40rpx;
  position: relative;
  overflow: hidden;
}

.page::before {
  content: "";
  position: fixed;
  top: -20%;
  right: -20%;
  width: 70%;
  height: 70%;
  background: radial-gradient(ellipse at center, rgba(111, 207, 151, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

.page::after {
  content: "";
  position: fixed;
  bottom: -20%;
  left: -15%;
  width: 50%;
  height: 50%;
  background: radial-gradient(ellipse at center, rgba(86, 204, 242, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.date-hero {
  position: relative;
  padding: 60rpx 40rpx 30rpx;
  margin-bottom: 32rpx;
}

.date-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.date-main {
  font-size: 100rpx;
  font-weight: 800;
  color: var(--color-text-main);
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  letter-spacing: -3rpx;
}

.date-main text {
  font-size: 52rpx;
  color: var(--color-primary);
  font-weight: 700;
  letter-spacing: -2rpx;
}

.decor-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.decor-circle-1 {
  width: 240rpx;
  height: 240rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.08), rgba(86, 204, 242, 0.05));
  top: 40rpx;
  right: -60rpx;
}

.decor-circle-2 {
  width: 160rpx;
  height: 160rpx;
  background: rgba(111, 207, 151, 0.06);
  top: 140rpx;
  right: 30rpx;
}

.summary-card {
  position: relative;
  margin: 0 28rpx 36rpx;
  padding: 44rpx 36rpx;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-elevated);
}

.summary-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.card-icon {
  width: 28rpx;
  height: 28rpx;
}

.budget-display {
  position: relative;
  margin-bottom: 36rpx;
}

.budget-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.budget-amount {
  font-size: 76rpx;
  font-weight: 800;
  color: var(--color-text-main);
  line-height: 1;
  letter-spacing: -2rpx;
}

.budget-amount text {
  font-size: 38rpx;
  color: var(--color-text-hint);
  font-weight: 400;
  letter-spacing: 0;
}

.stats-row {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  padding: 22rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.06), rgba(86, 204, 242, 0.04));
  border-radius: var(--radius-smooth);
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.stat-value.expense {
  color: var(--color-danger);
}

.stat-value.remain {
  color: var(--color-primary);
}

.quick-section {
  margin: 0 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--color-text-main);
  font-weight: 700;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-item {
  position: relative;
  padding: 26rpx 22rpx;
  background: var(--color-card);
  border-radius: var(--radius-smooth);
  box-shadow: var(--shadow-soft);
  transition: all 0.3s ease;
}

.quick-item:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-elevated);
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
}

.quick-btn::after {
  display: none;
}

.quick-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-main);
  font-weight: 600;
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.quick-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 10rpx;
  line-height: 1;
}

.quick-amount text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-text-hint);
}

.quick-count {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.quick-count::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  background: var(--color-accent);
  border-radius: 50%;
  margin-right: 6rpx;
  opacity: 0.7;
}

.decor-dot {
  position: fixed;
  border-radius: 50%;
  background: var(--color-primary);
  pointer-events: none;
}

.decor-dot-1 {
  width: 6rpx;
  height: 6rpx;
  top: 220rpx;
  left: 40rpx;
  opacity: 0.4;
}

.decor-dot-2 {
  width: 10rpx;
  height: 10rpx;
  top: 240rpx;
  left: 58rpx;
  opacity: 0.25;
}

.decor-line {
  position: fixed;
  height: 1px;
  background: var(--color-primary);
  pointer-events: none;
}

.decor-line-1 {
  width: 50rpx;
  top: 280rpx;
  right: 56rpx;
  opacity: 0.3;
}
