.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 36rpx;
  background: #f7f9fb;
}

.card {
  background: #ffffff;
  border: 1px solid #eef2f5;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(36, 56, 80, 0.06);
  margin-bottom: 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.today {
  font-size: 24rpx;
  color: #888888;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.kpi-item {
  background: #fbfdff;
  border: 1px solid #eef5f8;
  border-radius: 18rpx;
  padding: 18rpx 14rpx;
}

.kpi-label {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.kpi-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

.kpi-value.expense {
  color: #56ccf2;
}

.kpi-value.remain {
  color: #6fcf97;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-item {
  background: #fbfdff;
  border: 1px solid #eef5f8;
  border-radius: 18rpx;
  padding: 16rpx;
}

.quick-btn {
  height: 72rpx;
  line-height: 72rpx;
  border: none;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #2f4f4f;
  background: linear-gradient(135deg, #d7f6e2, #d8f2ff);
}

.quick-btn::after {
  border: none;
}

.quick-count {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888888;
}
