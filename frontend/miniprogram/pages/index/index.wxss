@import "../../app.wxss";

.page {
  background: linear-gradient(170deg, #d4edda 0%, #e8f5e9 25%, #f1f8e9 50%, #fdf8f0 80%, #fffaf5 100%);
}

/* ===== Page Shell ===== */

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ===== Decorative Background Orbs ===== */

.bg-orb {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-orb--1 {
  width: 500rpx;
  height: 500rpx;
  top: -120rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(111, 207, 151, 0.18) 0%, transparent 70%);
}

.bg-orb--2 {
  width: 400rpx;
  height: 400rpx;
  top: 45%;
  left: -140rpx;
  background: radial-gradient(circle, rgba(86, 204, 242, 0.12) 0%, transparent 70%);
}

.bg-orb--3 {
  width: 350rpx;
  height: 350rpx;
  bottom: 5%;
  right: -80rpx;
  background: radial-gradient(circle, rgba(255, 179, 138, 0.14) 0%, transparent 70%);
}

/* ===== Hero ===== */

.hero {
  position: relative;
  z-index: 1;
  padding: 48rpx 32rpx 0;
}

.hero-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 48rpx 40rpx 40rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 36rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 40rpx rgba(111, 207, 151, 0.1), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.hero-main {
  flex-shrink: 0;
}

.hero-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.hero-amount {
  display: block;
  font-size: 88rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
}

.hero-amount.positive {
  background: linear-gradient(135deg, var(--color-primary-deepdark) 0%, var(--color-primary-dark) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-amount.negative {
  background: linear-gradient(135deg, #C07030 0%, #FF6B6B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-date {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
  font-weight: 500;
}

.hero-quote-wrap {
  max-width: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.hero-quote-icon {
  font-size: 56rpx;
  line-height: 1;
  color: var(--color-primary);
  opacity: 0.3;
  font-family: Georgia, serif;
  margin-bottom: -8rpx;
}

.hero-quote {
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: right;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1.6;
  font-style: italic;
}

/* ===== Family Selector ===== */

.family-selector {
  position: relative;
  z-index: 100;
  margin: 24rpx 32rpx;
}

.family-selector-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  backdrop-filter: blur(16px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.family-selector-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.family-selector-left {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
}

.family-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.family-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.family-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.selector-arrow {
  font-size: 20rpx;
  color: var(--color-text-hint);
  transition: transform 0.3s ease;
}

.selector-arrow.arrow-up {
  transform: rotate(180deg);
}

.family-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12), 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: dropdownSlide 0.25s ease;
}

@keyframes dropdownSlide {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.family-option {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: background 0.2s ease;
}

.family-option:last-child {
  border-bottom: none;
}

.family-option-indicator {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: transparent;
  margin-right: 16rpx;
  transition: background 0.2s ease;
}

.family-option.active {
  background: rgba(111, 207, 151, 0.08);
  color: var(--color-primary);
  font-weight: 600;
}

.family-option.active .family-option-indicator {
  background: var(--color-primary);
}

/* ===== Summary Card ===== */

.summary-card {
  position: relative;
  z-index: 1;
  margin: 8rpx 32rpx 32rpx;
  padding: 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: var(--radius-card);
  backdrop-filter: blur(20px);
  box-shadow: 0 8rpx 32rpx rgba(111, 207, 151, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.summary-card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-primary));
  background-size: 200% 100%;
  animation: glowSlide 4s ease infinite;
}

@keyframes glowSlide {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.08), transparent);
  flex-shrink: 0;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-main);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.stat-value.expense {
  color: #FFB38A;
}
.stat-value.expense.today {
  color: #FF6B6B;
}

.stat-value.positive {
  color: var(--color-primary-dark);
}

/* ===== Quick Section ===== */

.quick-section {
  position: relative;
  z-index: 1;
  margin: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.section-title-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  color: var(--color-text-main);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.quick-item {
  padding: 28rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-card);
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: box-shadow 0.3s ease, transform 0.2s ease;
}

.quick-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.quick-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quick-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--color-text-main);
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
}

.quick-amount-badge {
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, rgba(111, 207, 151, 0.15), rgba(86, 204, 242, 0.1));
  border-radius: 20rpx;
}

.quick-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-primary-dark);
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.quick-calibrate {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.calibrate-btn {
  flex: 1;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.calibrate-btn--pos {
  background: rgba(255, 179, 138, 0.18);
  color: #C07030;
  border: 1rpx solid rgba(255, 179, 138, 0.2);
}

.calibrate-btn--neg {
  background: rgba(111, 207, 151, 0.12);
  color: var(--color-primary-dark);
  border: 1rpx solid rgba(111, 207, 151, 0.15);
}

.calibrate-btn:active {
  opacity: 0.5;
}

.calibrate-btn--active {
  opacity: 0.5;
  transform: scale(0.9);
}

.quick-record-btn {
  width: 100% !important;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  border: none;
  border-radius: 18rpx;
  padding: 0;
  margin: 0;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
  transition: all 0.2s ease;
}

.quick-record-btn::after {
  display: none;
}

.quick-record-btn:active {
  opacity: 0.85;
}

.quick-record-btn--active {
  opacity: 0.85;
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(111, 207, 151, 0.2);
}

/* "其他"项特殊样式 */
.quick-item--other {
  border: 1rpx solid rgba(255, 179, 138, 0.3);
  background: rgba(255, 248, 240, 0.5);
}

.quick-record-btn--other {
  background: linear-gradient(135deg, #FFB38A 0%, #FF8C61 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 138, 0.3);
}

/* ===== Modal ===== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  backdrop-filter: blur(4px);
  animation: modalFadeIn 0.2s ease;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.12), 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: modalSlideUp 0.25s ease;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-main);
  letter-spacing: 2rpx;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--color-text-hint);
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.modal-close:active {
  background: rgba(0, 0, 0, 0.05);
  opacity: 0.7;
}

.modal-body {
  padding: 32rpx;
  max-height: 900rpx;
  overflow-y: auto;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-section:last-child {
  margin-bottom: 0;
}

.form-section-title {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 分类按钮组 */
.category-group {
  margin-bottom: 24rpx;
}

.category-group-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.category-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.category-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  transition: all 0.2s ease;
  min-height: 64rpx;
}

.category-btn:active {
  transform: scale(0.98);
}

.category-btn.active {
  background: rgba(111, 207, 151, 0.15);
  border-color: rgba(111, 207, 151, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(111, 207, 151, 0.2);
}

.category-btn-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.category-btn-text {
  font-size: 24rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.required {
  color: #FF6B6B;
  margin-left: 4rpx;
}


.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-input:focus {
  background: rgba(255, 255, 255, 0.9);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(111, 207, 151, 0.1);
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 0;
  margin: 0;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.modal-btn::after {
  display: none;
}

.modal-btn--cancel {
  background: rgba(0, 0, 0, 0.04);
  color: var(--color-text-secondary);
}

.modal-btn--cancel:active {
  background: rgba(0, 0, 0, 0.08);
}

.modal-btn--confirm {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(111, 207, 151, 0.3);
}

.modal-btn--confirm:active {
  opacity: 0.85;
}

.modal-btn--confirm.disabled {
  background: rgba(0, 0, 0, 0.06);
  color: var(--color-text-hint);
  box-shadow: none;
  pointer-events: none;
}

/* ===== Loading ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8px);
}

.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 4rpx solid rgba(111, 207, 151, 0.15);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
