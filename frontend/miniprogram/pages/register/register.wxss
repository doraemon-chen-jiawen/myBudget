/* Register Page — Immersive Blue Gradient */

.register-page {
  min-height: 100vh;
  background: linear-gradient(170deg, #42B4D6 0%, #56CCF2 35%, #8DE0F5 60%, #C8EEF8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

/* Background decorations */
.bg-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bg-deco-1 {
  width: 420rpx;
  height: 420rpx;
  top: -120rpx;
  left: -100rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
}

.bg-deco-2 {
  width: 320rpx;
  height: 320rpx;
  bottom: 12%;
  right: -90rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
}

.bg-deco-3 {
  width: 200rpx;
  height: 200rpx;
  top: 28%;
  left: -30rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, transparent 70%);
}

/* ===== Branding ===== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  position: relative;
  z-index: 1;
  animation: fade-down 0.6s ease-out both;
}

.brand-icon {
  width: 128rpx;
  height: 128rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.06);
}

.brand-emoji {
  font-size: 60rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
  margin-bottom: 14rpx;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
}

/* ===== Form Card ===== */
.form-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 48rpx 44rpx;
  box-shadow: 0 24rpx 80rpx rgba(66, 180, 214, 0.14);
  position: relative;
  z-index: 1;
  animation: fade-up 0.6s ease-out 0.15s both;
}

/* Input groups */
.input-group {
  margin-bottom: 22rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 92rpx;
  background: #f3f7f9;
  border-radius: 46rpx;
  padding: 0 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.input-wrap:focus-within {
  background: #ffffff;
  border-color: #56CCF2;
  box-shadow: 0 0 0 6rpx rgba(86, 204, 242, 0.12);
}

.input-icon {
  font-size: 28rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
  color: #1E293B;
}

/* Submit button */
.submit-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border: none;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #42B4D6, #4ADE80);
  margin-top: 16rpx;
  padding: 0;
  letter-spacing: 6rpx;
  box-shadow: 0 14rpx 36rpx rgba(66, 180, 214, 0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn-active {
  opacity: 0.85;
  transform: scale(0.98);
  box-shadow: 0 8rpx 20rpx rgba(66, 180, 214, 0.25);
}

/* Switch link */
.switch-link {
  text-align: center;
  margin-top: 32rpx;
}

.switch-text {
  font-size: 26rpx;
  color: #94A3B8;
}

.switch-highlight {
  color: #42B4D6;
  font-weight: 600;
}

/* ===== Animations ===== */
@keyframes fade-down {
  from {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
