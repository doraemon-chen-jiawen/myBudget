<view class="register-page">
  <!-- Background decorations -->
  <view class="bg-deco bg-deco-1"></view>
  <view class="bg-deco bg-deco-2"></view>
  <view class="bg-deco bg-deco-3"></view>

  <!-- Branding -->
  <view class="brand-area">
    <view class="brand-icon">
      <text class="brand-emoji">🌱</text>
    </view>
    <text class="brand-name">创建账号</text>
    <text class="brand-slogan">开始你的预算管理之旅</text>
  </view>

  <!-- Form Card -->
  <view class="form-card">
    <view class="input-group">
      <view class="input-wrap">
        <text class="input-icon">👤</text>
        <input
          class="input-field"
          type="text"
          placeholder="请输入用户名"
          placeholder-style="color: #b8c4ce"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrap">
        <text class="input-icon">🔒</text>
        <input
          class="input-field"
          type="password"
          placeholder="请输入密码（至少6位）"
          placeholder-style="color: #b8c4ce"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrap">
        <text class="input-icon">🔑</text>
        <input
          class="input-field"
          type="password"
          placeholder="请再次输入密码"
          placeholder-style="color: #b8c4ce"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>
    </view>

    <view class="input-group">
      <view class="input-wrap">
        <text class="input-icon">✨</text>
        <input
          class="input-field"
          type="text"
          placeholder="请输入昵称（选填）"
          placeholder-style="color: #b8c4ce"
          value="{{nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
    </view>

    <button class="submit-btn" hover-class="submit-btn-active" bindtap="onRegister">注册</button>

    <view class="switch-link">
      <text class="switch-text" bindtap="onGoToLogin">已有账号？<text class="switch-highlight">去登录</text></text>
    </view>
  </view>
</view>
