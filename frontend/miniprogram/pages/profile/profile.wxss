/* Profile Page — Botanical Elegance */

.profile-page {
  min-height: 100vh;
  background: #f3f5f4;
  position: relative;
  overflow: hidden;
}

/* ===== Header ===== */
.header-section {
  background: linear-gradient(160deg, #4A9B6E 0%, #6FCF97 45%, #56CCF2 100%);
  padding: 56rpx 40rpx 100rpx;
  position: relative;
  overflow: hidden;
}

/* Decorative translucent circles for depth */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -100rpx;
  right: -80rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
}

.deco-2 {
  width: 200rpx;
  height: 200rpx;
  top: 40rpx;
  right: 120rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
}

.deco-3 {
  width: 160rpx;
  height: 160rpx;
  bottom: 10rpx;
  left: 30rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 70%);
}

/* User info layout */
.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
  animation: fade-in 0.6s ease-out both;
}

/* Avatar with animated ring */
.avatar-wrapper {
  position: relative;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  animation: pulse-ring 3s ease-in-out infinite;
}

@keyframes pulse-ring {
  0%, 100% { opacity: 0.35; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(1.05); }
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
}

.avatar-text {
  font-size: 58rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 42rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar-edit-icon {
  font-size: 22rpx;
}

/* User detail text */
.user-detail {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 6rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.user-id-badge {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
}

.user-id-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.5rpx;
}

/* Wave divider — organic curve */
.header-wave {
  height: 60rpx;
  background: #f3f5f4;
  border-radius: 60rpx 60rpx 0 0;
  margin-top: -36rpx;
  position: relative;
  z-index: 2;
}

/* ===== Quote Card ===== */
.quote-card {
  margin: -40rpx 32rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(111, 207, 151, 0.1), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 20rpx;
  animation: fade-up 0.5s ease-out 0.15s both;
}

.quote-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.quote-text {
  font-size: 28rpx;
  color: #4A9B6E;
  font-weight: 500;
  line-height: 1.6;
}

/* ===== Menu Groups ===== */
.menu-group {
  margin: 36rpx 32rpx 0;
  animation: fade-up 0.5s ease-out 0.25s both;
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #94A3B8;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.menu-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.025);
}

/* Menu items */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  transition: background 0.15s;
}

.menu-item + .menu-item {
  position: relative;
}

.menu-item + .menu-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 112rpx;
  right: 28rpx;
  height: 1rpx;
  background: #f0f2f5;
}

.menu-item-active {
  background: rgba(111, 207, 151, 0.05);
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

/* Colored icon boxes */
.icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-budget {
  background: rgba(111, 207, 151, 0.12);
}

.icon-stats {
  background: rgba(86, 204, 242, 0.12);
}

.icon-category {
  background: rgba(255, 179, 138, 0.15);
}

.icon-records {
  background: rgba(255, 179, 138, 0.15);
}

.icon-settings {
  background: rgba(167, 139, 250, 0.12);
}

.icon-help {
  background: rgba(74, 222, 128, 0.12);
}

.icon-emoji {
  font-size: 36rpx;
}

.menu-text-wrap {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1E293B;
  margin-bottom: 4rpx;
}

.menu-subtitle {
  font-size: 22rpx;
  color: #94A3B8;
}

.arrow-icon {
  font-size: 44rpx;
  color: #d0d4da;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== Logout ===== */
.logout-section {
  margin: 48rpx 32rpx 0;
  animation: fade-up 0.5s ease-out 0.35s both;
}

.logout-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: none;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FF6B6B;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.025);
  padding: 0;
  letter-spacing: 2rpx;
}

.logout-btn::after {
  border: none;
}

.logout-btn-active {
  background: #FFF5F5 !important;
  color: #e55555 !important;
}

/* ===== Footer ===== */
.footer {
  text-align: center;
  padding: 48rpx 0 80rpx;
  animation: fade-up 0.5s ease-out 0.45s both;
}

.footer-text {
  font-size: 22rpx;
  color: #c0c6ce;
  letter-spacing: 1rpx;
}

/* ===== Animations ===== */
@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
