<view class="profile-page">
  <view class="header-section">
    <view class="user-info">
      <view class="avatar">
        <text class="avatar-text">{{userInfo.nickname.charAt(0)}}</text>
      </view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="user-id">ID: {{userId || '未登录'}}</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="onNavigateToBudget">
      <view class="menu-item-left">
        <text class="menu-icon">💰</text>
        <text class="menu-text">预算设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onNavigateToSettings">
      <view class="menu-item-left">
        <text class="menu-icon">📊</text>
        <text class="menu-text">统计分析</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onNavigateToSettings">
      <view class="menu-item-left">
        <text class="menu-icon">🏷️</text>
        <text class="menu-text">分类管理</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onNavigateToSettings">
      <view class="menu-item-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
