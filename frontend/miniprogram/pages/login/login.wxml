<view class="login-page">
  <view class="login-card card">
    <view class="logo-section">
      <text class="app-name">懒人预算</text>
      <text class="app-slogan">轻松管理你的日常开销</text>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="form-label">用户名</text>
        <input
          class="form-input"
          type="text"
          placeholder="请输入用户名"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">密码</text>
        <input
          class="form-input"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button class="login-btn" bindtap="onLogin">登录</button>

      <view class="register-link">
        <text class="link-text" bindtap="onGoToRegister">没有账号？去注册</text>
      </view>
    </view>
  </view>
</view>
